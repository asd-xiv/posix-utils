#!/bin/sh

# ╭─────────┤ install
# │ Install posix-utils scripts to local bin
# │
# │ SYNOPSIS
# │   curl -sSL https://raw.githubusercontent.com/asd14/libs/main/posix-utils/install | sh
# │   sh install
# │
# │ DESCRIPTION
# │   Clones the repo (or uses existing checkout) and symlinks all
# │   scripts into PU_INSTALL_DIR. Idempotent — safe to run multiple times.
# │
# │ ENVIRONMENT
# │   PU_INSTALL_DIR   Target directory on PATH (default: ~/.local/bin)
# │   PU_REPO_DIR      Clone destination (default: ~/.local/share/posix-utils)
# │   PU_BRANCH        Git branch to clone (default: main)
# ╰────

# ╭───
# │ Bootstrap - Config
# ╰───

PU_REPO_URL="https://github.com/asd14/libs.git"
PU_REPO_SUBDIR="posix-utils"
PU_INSTALL_DIR="${PU_INSTALL_DIR:-$HOME/.local/bin}"
PU_REPO_DIR="${REPO_DIR:-$HOME/.local/share/posix-utils}"
PU_BRANCH="${BRANCH:-main}"

# ╭───
# │ Primitives
# ╰───

log() {
  printf "[posix-utils] %s\n" "$1" >&2
}

fail() {
  printf "[posix-utils] ERROR: %s\n" "$1" >&2
  exit 1
}

# ╭───
# │ Bootstrap
# ╰───

command -v git >/dev/null 2>&1 || fail "git is required."

mkdir -p "$PU_INSTALL_DIR" || fail "Cannot create $PU_INSTALL_DIR"

# Ensure PU_INSTALL_DIR is on PATH
case ":$PATH:" in
  *":$PU_INSTALL_DIR:"*) ;;
  *)
    log "WARNING: $PU_INSTALL_DIR is not on your PATH."
    log "Add to your shell profile: export PATH=\"$PU_INSTALL_DIR:\$PATH\""
    ;;
esac

# ╭───
# │ Main
# ╰───

# Clone or update
if [ -d "$PU_REPO_DIR/.git" ]; then
  log "Updating existing checkout…"
  git -C "$PU_REPO_DIR" pull --quiet origin "$PU_BRANCH" || fail "git pull failed."
else
  log "Cloning into $PU_REPO_DIR…"
  git clone --quiet --branch "$PU_BRANCH" --depth 1 "$PU_REPO_URL" "$PU_REPO_DIR" \
    || fail "git clone failed."
fi

SOURCE_DIR="$PU_REPO_DIR/$PU_REPO_SUBDIR"
[ -d "$SOURCE_DIR" ] || fail "Directory not found: $SOURCE_DIR"

# Install: loop scripts/
linked=0
for src in "$SOURCE_DIR"/scripts/*; do
  [ -f "$src" ] || continue
  script=$(basename "$src")
  dst="$PU_INSTALL_DIR/$script"

  chmod +x "$src"

  if [ -L "$dst" ]; then
    rm -f "$dst"
  elif [ -e "$dst" ]; then
    log "SKIP: $dst exists and is not a symlink."
    continue
  fi

  ln -s "$src" "$dst"
  linked=$((linked + 1))
done

log "Done. $linked scripts linked to $PU_INSTALL_DIR"
