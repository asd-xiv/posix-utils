#!/bin/sh

set -eu

# NAME
#   verify - Lint, parse and smoke test every script in bin/
#
# SYNOPSIS
#   ./verify
#
# DESCRIPTION
#   Runs shellcheck over every shell script in bin/, then parses and smoke
#   tests each one under dash and BusyBox ash. CI and a developer run the same
#   checks through this one script.
#
# OPTIONS
#   -h, --help    Print this help
#
# EXIT CODES
#   0: Every script passed
#   1: At least one script failed
#   3: Could not run, eg. a missing dependency
#
# SEE ALSO
#   shellcheck, dash, busybox

SCRIPT_DIR=$(dirname "$(realpath "$0")")
LOG_NAMESPACE="verify"
. "$SCRIPT_DIR/bin/lib.sh"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  ?*)
    _fail 2 -v argument "$1" "Takes no arguments."
    ;;
esac

# after the help branch, so --help still works with none of these installed
_require_cmd shellcheck dash busybox

# ╭───
# │ Main
# ╰───

_info "Checking bin/"

find "$SCRIPT_DIR/bin" -type f | sort | {
  # local to this subshell, not visible outside
  rc=0

  while IFS= read -r file; do
    # skip assets and anything else without a shell shebang
    head -1 "$file" 2>/dev/null | grep -qE '^#!.*[/ ](sh|bash|dash|ash)$' || continue

    name="${file#"$SCRIPT_DIR"/}"

    # 'set -e' is off on the left of ||, so every failure lands in its branch
    shellcheck -s sh "$file" || {
      _warn -v script "$name" "shellcheck failed."
      rc=1
    }

    dash -n "$file" || {
      _warn -v script "$name" "dash could not parse."
      rc=1
    }

    busybox sh -n "$file" || {
      _warn -v script "$name" "busybox could not parse."
      rc=1
    }

    dash "$file" --help >/dev/null || {
      _warn -v script "$name" "dash --help failed."
      rc=1
    }

    busybox sh "$file" --help >/dev/null || {
      _warn -v script "$name" "busybox --help failed."
      rc=1
    }
  done

  exit "$rc"
} || _fail 1 "Some scripts failed."

_ok "Every script passed."
exit 0
