{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/posix-utils",
  "version": "1.3.0",
  "description": "Composable, portable POSIX shell scripts.",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/posix-utils.git"
  },
  "keywords": [
    "posix",
    "shell",
    "utils",
    "utilities",
    "cross-platform",
    "git",
    "logging",
    "cli"
  ],
  "files": [
    "/bin",
    "/.ai"
  ],
  "scripts": {
    "prepare": "git config --local core.hooksPath .githook",
    "lint": "./tools/verify ./bin ./tools"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "semantic-release": "^25.0.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
