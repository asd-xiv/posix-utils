{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@asd14/posix-utils",
  "version": "3.0.0",
  "description": "Composable, portable POSIX shell scripts.",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asd-xiv/posix-utils.git"
  },
  "keywords": [
    "posix",
    "shell",
    "utils",
    "utilities",
    "cross-platform",
    "git",
    "logging",
    "cli"
  ],
  "files": [
    "/bin",
    "!/bin/**/*.t",
    "/.sh41/skills/write-posix-sh/SKILL.md"
  ],
  "scripts": {
    "prepare": "git config --local core.hooksPath .githook",
    "lint": "./tools/verify ./bin ./tools",
    "unit-test": "./tools/test",
    "format": "shfmt --write ./bin ./tools"
  },
  "devDependencies": {
    "@asd14/semantic-release-config": "^1.1.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "semantic-release": "^25.0.9"
  }
}
