#!/bin/sh

# ╭─────────┤ uninstall
# │ Remove posix-utils scripts from local bin
# │
# │ SYNOPSIS
# │   curl -sSL https://raw.githubusercontent.com/asd14/libs/main/posix-utils/uninstall | sh
# │   sh uninstall
# │
# │ DESCRIPTION
# │   Removes symlinks from INSTALL_DIR. With --purge, also removes
# │   the cloned repo. Only removes symlinks that point back to the
# │   posix-utils source — safe around other tools.
# │
# │ ENVIRONMENT
# │   PU_INSTALL_DIR   Target directory (default: ~/.local/bin)
# │   PU_REPO_DIR      Clone location (default: ~/.local/share/posix-utils)
# │   PU_PURGE         Set to "true" to also remove the cloned repo
# ╰────

# ╭───
# │ Bootstrap
# ╰───

PU_INSTALL_DIR="${INSTALL_DIR:-$HOME/.local/bin}"
PU_REPO_DIR="${REPO_DIR:-$HOME/.local/share/posix-utils}"
PU_PURGE="${PURGE:-false}"

# ╭───
# │ Primitives
# ╰───

log() {
  printf "[posix-utils] %s\n" "$1" >&2
}

# ╭───
# │ Main
# ╰───

# Uninstall: loop install dir, check if symlink points into our src/
removed=0
for dst in "$PU_INSTALL_DIR"/*; do
  [ -L "$dst" ] || continue

  target=$(readlink "$dst")
  case "$target" in
    */posix-utils/src/*)
      rm -f "$dst"
      removed=$((removed + 1))
      ;;
  esac
done

log "$removed scripts removed from $PU_INSTALL_DIR"

# Purge repo clone
if [ "$PU_PURGE" = "true" ] && [ -d "$PU_REPO_DIR" ]; then
  rm -rf "$PU_REPO_DIR"
  log "Removed $PU_REPO_DIR"
fi

[ "$PU_PURGE" != "true" ] && [ -d "$PU_REPO_DIR" ] && {
  log "Repo kept at $PU_REPO_DIR. Run with PU_PURGE=true to remove."
}
