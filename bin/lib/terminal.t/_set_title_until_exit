#!/bin/sh

# shellcheck disable=SC2329 # the harness calls prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"
. "$SCRIPT_DIR/../log.sh"
. "$SCRIPT_DIR/../os.sh"
. "$SCRIPT_DIR/../terminal.sh"

# _set_title writes only when stderr is a terminal. script(1) of util-linux
# runs a command on a pseudo-terminal
script -qec true /dev/null </dev/null >/dev/null 2>&1 \
  || _skip_all "script(1) of util-linux does not run"

# source_lib
#
# Print the lines that source terminal.sh and the files it needs.
source_lib() {
  printf '. "%s"\n' "$SCRIPT_DIR/../log.sh" "$SCRIPT_DIR/../os.sh" \
    "$SCRIPT_DIR/../terminal.sh"
}

# run_on_terminal
#
# Run the script on stdin on a pseudo-terminal, in a new shell that sources
# terminal.sh. Print what the terminal showed, with the ESC and BEL bytes of the
# title codes as the text \033 and \007, so a failed test prints them readable.
run_on_terminal() {
  {
    source_lib
    cat
  } >script.sh

  script -qec 'sh script.sh' /dev/null </dev/null \
    | sed "s/$(printf '\033')/\\\\033/g; s/$(printf '\007')/\\\\007/g"
}

_describe "lib/terminal.sh :: _set_title_until_exit :: valid"

_test 'given [a script that exits] should [set the title, then restore it]'
actual() {
  run_on_terminal <<'SCRIPT'
_set_title_until_exit "my title"
exit 0
SCRIPT
}
# A terminal shows stdout and stderr as one stream, which script prints on stdout
_expect equal actual.stdout '\033[22;0t\033]0;my title\007\033[23;0t'

_describe "lib/terminal.sh :: _set_title_until_exit :: edge"

_test 'given [an earlier _delete_on_exit call] should [keep that cleanup]'
prepare() { mkdir dir; }
actual() {
  run_on_terminal <<'SCRIPT'
_delete_on_exit "$PWD/dir"
_set_title_until_exit "my title"
exit 0
SCRIPT
  [ -e dir ] || printf 'deleted\n' >result.txt
}
_expect equal result.txt 'deleted'

_test 'given [no terminal] should [write nothing]'
actual() {
  {
    source_lib
    printf '_set_title_until_exit "my title"\n'
  } | sh -s
}
# Without a terminal in between, _set_title would write to stderr
_expect equal actual.stderr ''
