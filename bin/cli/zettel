#!/bin/sh

set -eu

# NAME
#   zettel - A Zettelkasten: write a thought down, place it in a box of zettels
#
# SYNOPSIS
#   zettel create [--behind <id>]
#   zettel place <file>
#   zettel sync [--no-place] [--wait]
#   zettel ls [--drafts] [--rows]
#   zettel show [--color] <id|file>
#   zettel recent
#   zettel browse [--drafts]
#   zettel edit <id|file>
#   zettel health
#   zettel -h | --help
#
# DESCRIPTION
#   A draft is one thought, one file in the folder of its day:
#   ~/NeoNotes/draft/<year>-<day of year>/<time>.md. Line 1 of a draft is its
#   claim, the thought as one sentence, written as "# <claim>".
#
#   A zettel is a note with an id, a file in the box:
#   ~/NeoNotes/box/<id>.<slug>.md. The id is a Folgezettel id, eg. 1b3: 1b3
#   stands behind 1b, and 1b behind 1. That chain is the lineage of 1b3. An id
#   holds no padding and never changes. The front matter of a zettel holds its
#   id and the time of its placing:
#
#     ---
#     id: 1b3
#     placed: 2026-10-14T12:00:00Z
#     ---
#
#     # <claim>
#
#   The front matter holds the id, the claim gives the slug. sync builds the
#   name from them.
#
#   To place a draft is to give it an id behind a parent. Place a draft behind
#   the zettel that made you think of it. Pick no parent when none did. The
#   draft then gets the next top-level id.
#
#     create    Open a new draft in Neovim, in this terminal. Line 1 is "# ",
#               and Neovim puts the cursor on line 3. When Neovim closes, run
#               sync. When Neovim ends with an error, eg. by ":cq", run
#               "sync --no-place". Wait for Enter when sync printed a line.
#               With --behind, the draft starts with the next free child id
#               of <id> in its front matter: sync elevates it with no picker
#     place     Give a draft an id. Show every zettel in the picker, a list
#               in fzf, the cursor on the last one placed. Type to search
#               the names. Enter writes the next child id of the zettel
#               under the cursor into the front matter of the draft, or the
#               next top-level id on the row "+ no parent". sync then
#               elevates the draft to the box. Esc keeps the draft as it
#               is. The first zettel of a box gets the id 1, with no
#               picker. An id in a draft counts as taken. Print the id
#     sync      Make the box and the drafts follow the rules:
#               1. Each zettel, oldest "placed:" first. A zettel
#                  without "id:" gets the id of its name. sync lowers a
#                  zettel with a broken format, or with the id of a zettel
#                  before it, to the drafts of today, with a message above
#                  its claim. The rest get the name "<id>.<slug of claim>.md"
#               2. Each draft, newest first. sync removes an empty draft:
#                  no front matter, no claim, no body. A draft with a claim
#                  and no "id:" goes to "place".
#                  A claim with no letter a-z and no digit gets a message
#               3. sync elevates each draft with a claim and "id:" to the
#                  box, newest first. A draft with a broken format, or with
#                  a taken id, stays with a message above its claim
#               A file with a message stays until you remove the message.
#               When the id of a zettel changes, "placed:" gets the time
#     ls        Print the id and the file name of every zettel, with a tab
#               between them, in Folgezettel order
#     show      Print the lineage of a zettel as a tree, an empty line, then
#               its text. For a draft, print its text only. Print nothing
#               for an empty argument
#     recent    Print the last 5 zettels placed with their lineage, as one
#               tree. The newest has "newest" after its name, behind a tab
#     browse    Open the browser: every zettel in fzf, with "show" as the
#               preview. Tab switches to the drafts, newest first, and
#               back. A draft with a sync message shows "⚠" and the
#               reason. Enter opens the file under the cursor with "edit".
#               Alt+Enter opens a new draft with "create", behind the
#               zettel under the cursor in the box. Esc closes the browser
#     edit      Open a zettel or a draft in Neovim, in this terminal. When
#               Neovim closes, run "sync --no-place". Wait for Enter when
#               sync printed a line
#     health    Print each reason zettel cannot work fully on this system,
#               one per line: a missing command. Print nothing when it
#               finds none. open-os-menu runs health before it lets you
#               pick browse
#
#   The folder in PU_ZETTEL_DIR is the only record. Only zettel shows the
#   Folgezettel order: a tool that sorts names as text lists 10 before 2.
#
#   When sync moves a draft into the box, it runs the on-place hook,
#   ~/.config/zettel/on-place <id> <file>, if that file is executable. <file>
#   is the path of the new zettel.
#
#   After sync adds, renames, moves or removes a file, it runs the on-update
#   hook, ~/.config/zettel/on-update, if that file is executable. zettel passes
#   it no arguments. The call tells the hook that the list of drafts or zettels
#   changed. sync does not call it for a change to the text alone. zettel
#   warns when a hook fails.
#
# ARGUMENTS
#   file   For place, a draft that holds a claim and no id. For show and
#          edit, a draft or a zettel: a path in the draft or the box folder
#   id     Zettel to show or to edit
#
# OPTIONS
#   --behind <id>
#                With create, start the draft behind the zettel <id>. An
#                empty <id> counts as none
#   --drafts     With ls, print the path of every draft, newest first. With
#                browse, open on the drafts
#   --rows       With ls, print the rows that the picker and the browser show
#                in fzf: id, file path and name, with a tab between them. A
#                draft row has no id
#   --color      With show, print the text through bat when bat is there
#   --no-place   With sync, place no draft. Print how many drafts with a
#                claim wait. Without a terminal on stdin, sync places none
#   --wait       With sync, wait for Enter after sync printed a line: a
#                change, a warning or the count of drafts that wait
#   -h, --help   Print this help
#
# ENVIRONMENT
#   PU_ZETTEL_DIR     Folder that holds "draft" and "box" (default: ~/NeoNotes)
#   XDG_CONFIG_HOME   Folder that holds the zettel config (default: ~/.config)
#   LOG_LEVEL         Last level to print (default: info)
#   NO_COLOR          Disables color when set and non-empty, in log lines
#                     and in the preview
#
# EXAMPLE
#   zettel create
#   zettel show 1b3
#
#   In ~/.config/zettel/on-update, to refresh the waybar module:
#
#     pkill -RTMIN+9 waybar
#
#   In ~/.config/zettel/on-place, to show the lineage of the new zettel:
#
#     notify-send "zettel" "$(zettel show "$1" | sed '/^$/q')"
#
# EXIT CODES
#   0   Done. For create, also when the draft stays or is removed
#   1   For health, zettel cannot work fully
#   2   Invalid usage, eg. a draft with no claim or an id with no zettel
#   3   Could not run, eg. no fzf, no Neovim or no terminal. For sync,
#       place could not run
#   4   For place, no parent picked, the draft stays
#
# SEE ALSO
#   zettel-bar, open-os-menu, nvim, fzf, awk, bat

# tools/install symlinks this script, so "$0" names the link. realpath follows
# it to find lib.sh and zettel.d
SCRIPT_FILE=$(realpath "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_FILE")
. "$SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="zettel"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
  --) shift ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

[ "$#" -eq 0 ] && _fail 2 "No command given"

COMMAND="$1"
shift

# "zettel place -- <file>" works like "zettel place <file>"
if [ "${1:-}" = "--" ]; then
  shift
fi

# ╭───
# │ Main
# ╰───

# One file per command. A slug holds no "/" and no ".", so a command names
# only a file in zettel.d, and never zettels.sh
COMMAND_FILE="$SCRIPT_DIR/zettel.d/$COMMAND"

if ! _is slug "$COMMAND" || [ ! -f "$COMMAND_FILE" ] || [ ! -x "$COMMAND_FILE" ]; then
  _fail 2 -v command "$COMMAND" "Unknown command"
fi

exec "$COMMAND_FILE" "$@"
