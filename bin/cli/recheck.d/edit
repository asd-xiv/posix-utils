#!/bin/sh

# NAME
#   recheck edit - Edit the checks in Neovim, then sync
#
# SYNOPSIS
#   recheck edit [id]
#
# DESCRIPTION
#   Starts Neovim in ~/.config/recheck, in this terminal. With an id, opens
#   only the file of that check. Syncs when Neovim closes without an error.
#   Waits for Enter when the sync changed the crontab, left a check out or
#   failed, so a window opened only for edit stays open to read.
#
# ARGUMENTS
#   id   Check to open
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an id with no check
#   3   Could not run, eg. no nvim, no terminal or Neovim ended with an error
#
#   A failed sync exits with the code of sync.
#
# SEE ALSO
#   nvim, recheck sync

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/guard.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/../../lib/terminal.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

# ╭───
# │ Cleanup
# ╰───

# shellcheck disable=SC2329 # called by trap
cleanup() {
  _restore_title
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

[ "$#" -le 1 ] || _fail 2 '"edit" takes at most one id'
guard_id "$@"
_require_cmd nvim crontab awk
guard_recheck_file
[ -t 0 ] || _fail 3 '"edit" needs a terminal'

mkdir -p -- "$CHECKS_DIR"
cd -- "$CONFIG_DIR"

# What Neovim opens: one file, or the folder with the nvim-tree pane, when
# that plugin is there
if [ "$#" -eq 1 ]; then
  FILE=$(find_check_file "$1")
  TITLE="recheck :: editor - $1"
  set -- -- "checks/${FILE##*/}"
else
  TITLE="recheck :: editor"
  set -- -c 'silent! NvimTreeFocus'
fi

# Neovim with its 'title' option on renames the window. Hand it the same
# title, so the window keeps one name. An id is a slug, safe between quotes
_set_title "$TITLE"
nvim -c "let &titlestring = '$TITLE'" "$@" \
  || _fail 3 "Neovim ended with an error, not synced"

# A window opened only for this command closes with it, before the user reads
# what it shows. So wait for Enter when there is something to read. "sync
# --wait" waits after sync printed the lines that changed, or the warning for a
# check it left out. When sync fails, it ends before that wait, so edit waits
# here. A sync that printed neither exits at once and the window closes
"$RECHECK_FILE" sync --wait || {
  STATUS=$?
  _wait_for_enter
  exit "$STATUS"
}

exit 0
