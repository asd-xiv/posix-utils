#!/bin/sh

# NAME
#   recheck log - Print the last runs
#
# SYNOPSIS
#   recheck log [-n <count>] [id-or-folgezettel...]
#
# DESCRIPTION
#   Prints the last 10 lines of the run log, ~/.local/state/recheck/runs.log,
#   one per run. Prints the path of the run log to stderr. With ids or
#   Folgezettels, prints only the runs of the checks they select, then the
#   last 10 of those. "recheck run --help" describes a line.
#
# ARGUMENTS
#   id-or-folgezettel   An id, eg. 05a_t212-snapshot-close, or a Folgezettel:
#                       the part of an id before its first "_", eg. 05. A
#                       Folgezettel selects the check at it and each check
#                       under it: 05 selects 05a and 05a1, not 051. An
#                       argument without "_" is a Folgezettel, so an id
#                       without "_", eg. foo, also selects each check under
#                       it. Repeatable
#
# OPTIONS
#   -n <count>   Print the last <count> runs (default: 10)
#   -h, --help   Print this help
#
# EXAMPLE
#   recheck log -n 50
#   recheck log 05a_t212-snapshot-close
#   recheck log -n 20 05
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an id or a Folgezettel with no check, or -n without a
#       count
#
# SEE ALSO
#   recheck run

# recheck runs this file. Never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

# ╭───
# │ Primitives
# ╰───

# find_ids_under <folgezettel>
# Print the id of each check at <folgezettel> or under it, one per line. A
# Folgezettel is under <folgezettel> when it starts with <folgezettel> and its
# next character is of the other kind: a letter after a digit, eg. 05a under
# 05, or a digit after a letter, eg. 05a1 under 05a. 051 is not under 05.
find_ids_under() {
  for fiu_id in $(find_ids); do
    fiu_folgezettel="${fiu_id%%_*}"
    fiu_rest="${fiu_folgezettel#"$1"}"
    [ "$fiu_rest" != "$fiu_folgezettel" ] || continue

    case "$1:$fiu_rest" in
      *:) ;;
      *[0-9]:[A-Za-z]*) ;;
      *[A-Za-z]:[0-9]*) ;;
      *) continue ;;
    esac
    printf '%s\n' "$fiu_id"
  done
}

# ╭───
# │ Bootstrap
# ╰───

COUNT=10

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      _show_help "$0"
      exit 0
      ;;
    -n)
      [ "$#" -ge 2 ] || _fail 2 "-n needs a count"
      _is positive-integer "$2" || _fail 2 -v count "$2" "Not a count"
      COUNT="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
    *) break ;;
  esac
done

# An argument with a "_" is an id, one without is a Folgezettel
IDS=""
for ARG in "$@"; do
  case "$ARG" in
    *_*)
      guard_id "$ARG"
      IDS="$IDS $ARG"
      ;;
    *)
      _is slug "$ARG" || _fail 2 -v folgezettel "$ARG" "Not a Folgezettel"
      UNDER_IDS=$(find_ids_under "$ARG")
      [ -n "$UNDER_IDS" ] \
        || _fail 2 -v folgezettel "$ARG" "No check at this Folgezettel"
      for UNDER_ID in $UNDER_IDS; do
        IDS="$IDS $UNDER_ID"
      done
      ;;
  esac
done

# ╭───
# │ Main
# ╰───

_info -v path "$RUN_LOG_FILE" "Log file"

# The fifth field of a line is the id. An id is a slug, with no space, so awk
# splits the ids on a space
if [ -f "$RUN_LOG_FILE" ]; then
  awk -F '\t' -v ids="$IDS" '
    BEGIN {
      count = split(ids, list, " ")
      for (i = 1; i <= count; i++) is_wanted[list[i]] = 1
    }
    count == 0 || ($5 in is_wanted)' "$RUN_LOG_FILE" | tail -n "$COUNT"
fi

exit 0
