#!/bin/sh

# NAME
#   recheck log - Print the last 10 runs
#
# SYNOPSIS
#   recheck log
#
# DESCRIPTION
#   Prints the last 10 lines of the run log, one per run, and the path of the
#   log file to stderr. "recheck run --help" describes a line.
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an argument
#
# SEE ALSO
#   recheck run

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"log" takes no arguments'

_info -v path "$RUN_LOG_FILE" "Log file"

if [ -f "$RUN_LOG_FILE" ]; then
  tail -n 10 -- "$RUN_LOG_FILE"
fi

exit 0
