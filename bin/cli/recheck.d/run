#!/bin/sh

# NAME
#   recheck run - Run the enabled checks, or the ones named
#
# SYNOPSIS
#   recheck run [id...]
#
# DESCRIPTION
#   Runs every enabled check, or only the ones named, then runs the on-update
#   hook. Skips a disabled check and a check that is already running. Prints
#   "<id>", a tab and "<state>" per check. cron calls it. At a terminal, also
#   prints what each check printed, to stderr.
#
#   A check with a retry line runs again while it is not green, up to its
#   retries. The last run is the answer: run keeps it and runs the on-change
#   hook for it.
#
#   run keeps the last run, the last green or red, and the last output of a
#   check in ~/.local/state/recheck/<id>/. It appends one line per run,
#   retries included, to ~/.local/state/recheck/runs.log: time, state, exit
#   code, seconds the run took and id. A retry adds "<retry>/<retries>".
#
#   While a check and its retries run, run keeps its lock: the folder
#   <id>.lock in /run/user/<user id>/recheck. It holds pid, the process id of
#   the run command, and started, the time the check started. From the first
#   retry on, it also holds retry: "<retry>/<retries>". While a check has a
#   lock, run skips it, and status, show and "ls --color" report it as
#   running. A run command that ends by "kill -9" leaves the lock. It stays
#   until you remove it with "rm -r", or until the next boot clears
#   /run/user/<user id>.
#
# ARGUMENTS
#   id   Check to run. Repeatable
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done, whatever the answers
#   2   Invalid usage, eg. an id with no check
#   3   It could not take the lock of at least one check. It ran the others
#
# SEE ALSO
#   recheck status, recheck log

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

CHANGE_HOOK_FILE="$CONFIG_DIR/on-change"
RUNNING_CHECK_ID=""
LOCK_DIR=""   # the lock this run command took, "" when it holds none
HAS_FAILED="" # "true" once run could not take the lock of a check

# ╭───
# │ Primitives
# ╰───

# map_state <exit-code>
# Print the state an exit code of a check means: green, red or broken.
map_state() {
  case "$1" in
    0) printf 'green' ;;
    1) printf 'red' ;;
    *) printf 'broken' ;;
  esac
}

# take_lock <id>
# Make the lock of a check, then write its pid and its start time.
#
# RETURNS
#   0   run made the lock
#   1   The check has a lock already
#   2   run cannot make the lock
take_lock() {
  lock_dir=$(print_lock_dir "$1") || return 2

  # A boot removes the runtime folder. When mkdir -p fails, the next mkdir
  # fails too. Then take_lock returns 2
  mkdir -p -- "$RUNTIME_DIR" 2>/dev/null || true

  # mkdir makes the lock only when there is none, in one system call. So only
  # one of two run commands that start together makes it
  if ! mkdir -- "$lock_dir" 2>/dev/null; then
    # mkdir gives one exit code for "the lock exists" and for "cannot make the
    # lock". So ask whether the lock exists. In one rare case another run
    # command removes the lock after mkdir fails. Then take_lock wrongly returns
    # 2 for a check that just ran
    if [ -d "$lock_dir" ]; then
      return 1
    fi

    return 2
  fi

  # From here on the cleanup removes the lock
  RUNNING_CHECK_ID="$1"
  LOCK_DIR="$lock_dir"

  # Written once, so no temporary file. A reader takes a missing or empty
  # "started" as an empty time
  if ! { printf '%s\n' "$$" >"$LOCK_DIR/pid" \
    && printf '%s\n' "$(date +%T)" >"$LOCK_DIR/started"; } 2>/dev/null; then
    remove_lock
    return 2
  fi

  return 0
}

# remove_lock
# Remove the lock this run command took. A person can remove it first.
remove_lock() {
  if [ -d "$LOCK_DIR" ]; then
    rm -r -- "${LOCK_DIR:?}"
  fi
  RUNNING_CHECK_ID=""
  LOCK_DIR=""
}

# format_run <exit-code> <seconds>
# Print a finished run as one line: time, state, exit code and seconds, with a
# tab between them.
format_run() {
  printf '%s\t%s\t%s\t%ss' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$(map_state "$1")" "$1" "$2"
}

# record_run <id> <exit-code> <run-line>
# Keep the answer of a check and print "<id>", a tab and "<state>". Run the
# on-change hook when the check went from green to red or back.
record_run() {
  record_dir="$STATE_DIR/$1"
  record_state=$(map_state "$2")

  printf '%s\n' "$3" >"$record_dir/last"
  printf '%s\t%s\n' "$1" "$record_state"

  # Broken is no answer. recheck keeps the last green or red and runs no hook
  if [ "$record_state" = "broken" ]; then
    return 0
  fi

  record_old_state=""
  if [ -f "$record_dir/state" ]; then
    record_old_state=$(cat -- "$record_dir/state")
  fi

  printf '%s\n' "$record_state" >"$record_dir/state"

  if [ -n "$record_old_state" ] && [ "$record_old_state" != "$record_state" ]; then
    run_hook "$CHANGE_HOOK_FILE" "$1" "$record_old_state" "$record_state"
  fi

  return 0
}

# run_check <id>
# Run a check, and its retries while it is not green, then keep the answer.
# Skip the check when it has a lock. When run cannot take the lock, log an
# error, set HAS_FAILED and skip the check.
run_check() {
  run_dir="$STATE_DIR/$1"
  mkdir -p -- "$run_dir"

  run_lock_status=0
  take_lock "$1" || run_lock_status=$?

  case "$run_lock_status" in
    0) ;;
    1)
      _info -v id "$1" -v lock "$(print_lock_dir "$1")" \
        "Already running, skipping"
      return 0
      ;;
    *)
      _error -v id "$1" -v lock "$(print_lock_dir "$1")" \
        "Could not take the lock"
      HAS_FAILED="true"
      return 0
      ;;
  esac

  # In the background, so a slow hook does not delay the check
  run_hook "$UPDATE_HOOK_FILE" &

  run_retries=0
  run_delay=0
  if run_retry=$(find_retry "$1"); then
    run_retries="${run_retry% *}"
    run_delay="${run_retry#* }"
  fi

  # A run that is not green runs the check again, up to run_retries times. The
  # first green, or the last retry, is the answer
  run_attempt=0
  while :; do
    # Into output.new, so an interrupted run leaves the last output in place
    run_start_seconds=$(date +%s)
    run_status=0
    run_with_env "$CHECKS_DIR/$1" </dev/null >"$run_dir/output.new" 2>&1 \
      || run_status=$?
    run_line=$(format_run "$run_status" "$(($(date +%s) - run_start_seconds))")

    # The log is for a person: "recheck log" prints it, nothing parses it. It
    # adds the id, and "<retry>/<retries>" on a retry
    if [ "$run_attempt" -eq 0 ]; then
      printf '%s\t%s\n' "$run_line" "$1" >>"$RUN_LOG_FILE"
    else
      printf '%s\t%s\t%s/%s\n' "$run_line" "$1" "$run_attempt" "$run_retries" \
        >>"$RUN_LOG_FILE"
    fi

    if [ "$run_status" -eq 0 ] || [ "$run_attempt" -ge "$run_retries" ]; then
      break
    fi

    run_attempt=$((run_attempt + 1))
    printf '%s/%s\n' "$run_attempt" "$run_retries" >"$LOCK_DIR/retry"
    sleep $((run_delay * 60))
  done

  mv -- "$run_dir/output.new" "$run_dir/output"
  remove_lock

  # Show the output to a person at a terminal. cron mails what goes to stderr
  if [ -t 2 ]; then
    cat -- "$run_dir/output" >&2
  fi

  record_run "$1" "$run_status" "$run_line"
}

# run_checks <id>...
# Run each named check, then run the on-update hook. Skip a disabled check.
run_checks() {
  guard_id "$@"

  for named_id in "$@"; do
    if is_enabled "$named_id"; then
      run_check "$named_id"
    else
      _info -v id "$named_id" "Disabled, skipping"
    fi
  done

  run_hook "$UPDATE_HOOK_FILE"

  return 0
}

# ╭───
# │ Cleanup
# ╰───

# A run command that ends by Ctrl+C, kill or a closed window leaves no lock and
# no half output. The last full run stays as it was. The bar learns it through
# the on-update hook, the browser through its reload. After kill -9 the shell
# runs no trap: that run command leaves its lock and its half output
# shellcheck disable=SC2329 # called by trap
cleanup() {
  [ -n "$RUNNING_CHECK_ID" ] || return 0

  rm -f -- "$STATE_DIR/$RUNNING_CHECK_ID/output.new"
  remove_lock
  run_hook "$UPDATE_HOOK_FILE"
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

if [ "$#" -eq 0 ]; then
  # shellcheck disable=SC2046 # ids are slugs, safe to split
  set -- $(find_enabled_ids)
fi

# Without a runtime folder, run can take no lock and skips every check. Log
# why once: _get_runtime_dir names the folder it looked for
if [ -z "$RUNTIME_DIR" ]; then
  (_get_runtime_dir >/dev/null) || true
fi

run_checks "$@"

if [ -n "$HAS_FAILED" ]; then
  exit 3
fi
exit 0
