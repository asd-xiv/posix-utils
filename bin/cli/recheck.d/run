#!/bin/sh

# recheck run [id...]
#
# Run every enabled check, or only the ones named, then run the on-update
# hook.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/checks.sh"

CHANGE_HOOK_FILE="$CONFIG_DIR/on-change"
RUNNING_ID="" # the check this process marked, "" when it marked none

# ╭───
# │ Primitives
# ╰───

# map_state <exit-code>
# Print the state an exit code of a check means: green, red or broken.
map_state() {
  case "$1" in
    0) printf 'green' ;;
    1) printf 'red' ;;
    *) printf 'broken' ;;
  esac
}

# mark_run <id>
# Create the marker of a check. Return 1 when the check has one already, or when
# the shell cannot write it.
mark_run() {
  mark_file=$(print_marker_file "$1")

  # With noclobber, the shell creates the marker only when there is none, in one
  # system call. So only one of two run commands that start together creates it
  (set -C && printf '%s %s\n' "$$" "$(date +%T)" >"$mark_file") 2>/dev/null \
    || return 1

  RUNNING_ID="$1"
}

# unmark_run
# Remove the marker this process created.
unmark_run() {
  rm -f -- "$(print_marker_file "$RUNNING_ID")"
  RUNNING_ID=""
}

# record_run <id> <exit-code> <seconds>
# Keep a finished run and print "<id>", a tab and "<state>". Run the on-change
# hook when the check went from green to red or back.
record_run() {
  record_dir="$STATE_DIR/$1"
  record_state=$(map_state "$2")
  record_line=$(
    printf '%s\t%s\t%s\t%ss' \
      "$(date +%Y-%m-%dT%H:%M:%S%z)" "$record_state" "$2" "$3"
  )

  # The same line in two files, the log adds the id. recheck reads "last".
  # The log is for a person: "recheck log" prints it, nothing parses it
  printf '%s\n' "$record_line" >"$record_dir/last"
  printf '%s\t%s\n' "$record_line" "$1" >>"$RUN_LOG_FILE"

  printf '%s\t%s\n' "$1" "$record_state"

  # Broken is no answer. recheck keeps the last green or red and runs no hook
  if [ "$record_state" = "broken" ]; then
    return 0
  fi

  record_old_state=""
  if [ -f "$record_dir/state" ]; then
    record_old_state=$(cat -- "$record_dir/state")
  fi

  printf '%s\n' "$record_state" >"$record_dir/state"

  if [ -n "$record_old_state" ] && [ "$record_old_state" != "$record_state" ]; then
    run_hook "$CHANGE_HOOK_FILE" "$1" "$record_old_state" "$record_state"
  fi

  return 0
}

# run_check <id>
# Run a check and keep the run. Skip a check that has a marker.
run_check() {
  run_dir="$STATE_DIR/$1"
  mkdir -p -- "$run_dir"

  if ! mark_run "$1"; then
    _info -v id "$1" -v marker "$(print_marker_file "$1")" \
      "Already running, skipping"
    return 0
  fi

  # In the background, so a slow hook does not delay the check
  run_hook "$UPDATE_HOOK_FILE" &

  # Into output.new, so an interrupted run leaves the last output in place
  run_start_seconds=$(date +%s)
  run_status=0
  run_with_env "$CHECKS_DIR/$1" </dev/null >"$run_dir/output.new" 2>&1 \
    || run_status=$?
  run_seconds=$(($(date +%s) - run_start_seconds))

  mv -- "$run_dir/output.new" "$run_dir/output"
  unmark_run

  # Show the output to a person at a terminal. cron mails what goes to stderr
  if [ -t 2 ]; then
    cat -- "$run_dir/output" >&2
  fi

  record_run "$1" "$run_status" "$run_seconds"
}

# run_checks <id>...
# Run each named check, then run the on-update hook. Skip a disabled check.
# Create the runtime folder first, exit 3 when it is missing or read-only.
run_checks() {
  guard_id "$@"

  # mark_run cannot create a marker in a folder that is missing or read-only,
  # and run_check would report that as "Already running"
  if ! mkdir -p -- "$RUNTIME_DIR" || [ ! -w "$RUNTIME_DIR" ]; then
    _fail 3 -v path "$RUNTIME_DIR" \
      "No writable runtime folder, set XDG_RUNTIME_DIR"
  fi

  for named_id in "$@"; do
    if is_enabled "$named_id"; then
      run_check "$named_id"
    else
      _info -v id "$named_id" "Disabled, skipping"
    fi
  done

  run_hook "$UPDATE_HOOK_FILE"

  return 0
}

# ╭───
# │ Cleanup
# ╰───

# A run command that ends by Ctrl+C, kill or a closed window leaves no marker
# and no half output. The last full run stays as it was. The bar learns it
# through the on-update hook, the browser through its reload. After kill -9 the
# shell runs no trap: that run command leaves its marker and its half output
# shellcheck disable=SC2329 # called by trap
cleanup() {
  [ -n "$RUNNING_ID" ] || return 0

  rm -f -- "$STATE_DIR/$RUNNING_ID/output.new"
  unmark_run
  run_hook "$UPDATE_HOOK_FILE"
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

if [ "$#" -eq 0 ]; then
  # shellcheck disable=SC2046 # ids are slugs, safe to split
  set -- $(find_enabled_ids)
fi
run_checks "$@"

exit 0
