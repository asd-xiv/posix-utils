#!/bin/sh

# NAME
#   recheck sync - Write the recheck block of the crontab from the checks
#
# SYNOPSIS
#   recheck sync [--wait]
#
# DESCRIPTION
#   Makes every check executable. Replaces the recheck block of the crontab
#   with one line per enabled check that has a valid cron pattern, prints the
#   lines that changed to stderr, then runs the on-update hook. When the block
#   is already the same, writes no crontab and runs no hook. Warns about a
#   check without a valid cron pattern and leaves it out.
#
#   Run it after a change made outside "recheck edit": a new check, a rename
#   by hand or a changed cron pattern.
#
# OPTIONS
#   --wait       Wait for Enter after sync printed the lines that changed, or
#                the warning for a check it left out
#   -h, --help   Print this help
#
# ENVIRONMENT
#   NO_COLOR   Disables color in the lines that changed when set and
#              non-empty
#
# EXIT CODES
#   0   Done, also when it left a check out
#   2   Invalid usage, eg. an argument
#   3   Could not run, eg. no crontab command, or a crontab with one block
#       marker but not the other
#
# SEE ALSO
#   crontab, recheck ls --cron

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/guard.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/../../lib/text.sh"
. "$SCRIPT_DIR/../../lib/terminal.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

BLOCK_BEGIN="# recheck:start"
BLOCK_END="# recheck:end"

# ╭───
# │ Primitives
# ╰───

# read_crontab
# Print the crontab. Print nothing when the user has no crontab yet.
read_crontab() {
  # crontab reports "no crontab yet" as a failure with a message. Any other
  # failure must stop here, or sync writes back a crontab without the user's
  # own lines
  read_crontab_text=$(LC_ALL=C crontab -l 2>&1) || {
    case "$read_crontab_text" in
      *"no crontab"*) return 0 ;;
      *) _fail 3 -v error "$read_crontab_text" "Could not read the crontab" ;;
    esac
  }

  printf '%s' "$read_crontab_text"
}

# ╭───
# │ Main
# ╰───

if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--wait" ]; }; then
  _fail 2 '"sync" takes only --wait'
fi

_require_cmd crontab awk
guard_recheck_file

# Make every file in the checks folder executable, or recheck cannot run
# it. A check written in `recheck edit` starts without +x
for FILE in "$CHECKS_DIR"/*; do
  [ -f "$FILE" ] || continue
  [ -x "$FILE" ] && continue

  chmod a+x -- "$FILE" \
    || _fail 3 -v path "$FILE" "Could not make executable"
  _info -v path "$FILE" "Made executable"
done

# A lone assignment fails with the status of read_crontab, and 'set -e'
# ends the script with it. The write below must never run on a text that
# is not the whole crontab
CRONTAB_TEXT=$(read_crontab)

# Two blocks, or a marker without its pair: stop, the block has no known
# bounds. Fixing that by hand is safer than a guess in someone's crontab
OLD_BLOCK=$(
  printf '%s\n' "$CRONTAB_TEXT" \
    | _find_block "$BLOCK_BEGIN" "$BLOCK_END"
) || _fail 3 -v begin "$BLOCK_BEGIN" -v end "$BLOCK_END" \
  "The crontab must hold both markers once or neither, the begin marker above the end marker"

# A check left out is a warning, not a failure. With --wait, sync waits so the
# user reads it
WAIT_FLAG=""
NEW_BLOCK=$(list_cron_lines) || WAIT_FLAG="${1:-}"

if [ "$OLD_BLOCK" = "$NEW_BLOCK" ]; then
  _info "Crontab unchanged"

  if [ "$WAIT_FLAG" = "--wait" ]; then
    _wait_for_enter
  fi

  exit 0
fi

NEW_TEXT=$(
  printf '%s\n' "$CRONTAB_TEXT" \
    | _replace_block "$BLOCK_BEGIN" "$BLOCK_END" "$NEW_BLOCK"
) || _fail 3 "Could not build the new crontab"

OUTPUT=$(_end_with_newline "$NEW_TEXT" | crontab - 2>&1) \
  || _fail 3 -v error "$OUTPUT" "Could not write the crontab"

_diff_lines "$OLD_BLOCK" "$NEW_BLOCK" >&2
run_hook "$UPDATE_HOOK_FILE"

_ok "Crontab updated"

if [ "${1:-}" = "--wait" ]; then
  _wait_for_enter
fi

exit 0
