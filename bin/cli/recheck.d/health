#!/bin/sh

# NAME
#   recheck health - Print each reason recheck cannot work fully
#
# SYNOPSIS
#   recheck health
#
# DESCRIPTION
#   Prints each reason recheck cannot work fully on this system, one per
#   line, on stdout: a missing command, an fzf older than 0.73.0, PU_TERMINAL
#   not set or a script path that is not safe. Each line names the command
#   that needs the thing. Prints nothing when it finds none. health does not
#   check the terminal, the caller opens it. open-os-menu runs health before
#   it lets a person pick browse.
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   recheck can work fully
#   1   recheck cannot work fully
#   2   Invalid usage, eg. an argument
#
# SEE ALSO
#   open-os-menu, recheck browse

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"health" takes no arguments'

HAS_REASON=""

if ! command -v crontab >/dev/null 2>&1; then
  printf '%s\n' "crontab not found, sync, enable, disable and edit need it"
  HAS_REASON="true"
fi

if ! command -v awk >/dev/null 2>&1; then
  printf '%s\n' "awk not found, sync, enable, disable and edit need it"
  HAS_REASON="true"
fi

if ! is_recheck_file_safe; then
  printf '%s\n' "recheck path has a character outside A-Za-z0-9_@+=:,./-"
  HAS_REASON="true"
fi

if ! command -v fzf >/dev/null 2>&1; then
  printf '%s\n' "fzf not found, browse needs fzf 0.73.0 or newer"
  HAS_REASON="true"
else
  FZF_VERSION=$(find_fzf_version)

  if ! is_fzf_new_enough "$FZF_VERSION"; then
    printf '%s\n' \
      "fzf ${FZF_VERSION:-unknown} is too old, browse needs 0.73.0 or newer"
    HAS_REASON="true"
  fi
fi

if ! command -v nvim >/dev/null 2>&1; then
  printf '%s\n' "nvim not found, edit needs it"
  HAS_REASON="true"
fi

if [ -z "${PU_TERMINAL:-}" ]; then
  printf '%s\n' "PU_TERMINAL not set, Alt+Enter in browse needs it"
  HAS_REASON="true"
fi

if [ -n "$HAS_REASON" ]; then
  exit 1
fi

exit 0
