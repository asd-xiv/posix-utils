#!/bin/sh

# NAME
#   recheck disable - Disable checks, then sync
#
# SYNOPSIS
#   recheck disable <id>...
#
# DESCRIPTION
#   Puts a "_" in front of the file name of each check, then runs sync.
#   Guards every id first, so a failure renames no check.
#
# ARGUMENTS
#   id   Check to disable. Repeatable
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an id with no check
#   3   Could not run, eg. a disabled copy of the check exists or no crontab
#       command
#
# SEE ALSO
#   recheck enable, recheck toggle, recheck sync

# recheck runs this file. Never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/guard.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

# ╭───
# │ Main
# ╰───

[ "$#" -gt 0 ] || _fail 2 '"disable" needs at least one id'

# Guard everything before the first rename, so a failure changes nothing
guard_id "$@"
for ID in "$@"; do
  if is_enabled "$ID" && [ -f "$CHECKS_DIR/_$ID" ]; then
    _fail 3 -v id "$ID" \
      "A disabled copy exists, the rename would replace it"
  fi
done
_require_cmd crontab awk
guard_recheck_file

for ID in "$@"; do
  is_enabled "$ID" || continue
  mv -- "$CHECKS_DIR/$ID" "$CHECKS_DIR/_$ID"
  _ok -v id "$ID" "Check disabled"
done

"$RECHECK_FILE" sync

exit 0
