#!/bin/sh

# NAME
#   recheck show - Print a check and the output of its last run
#
# SYNOPSIS
#   recheck show [--color] <id>
#
# DESCRIPTION
#   Prints a check as properties between "---" lines, as in front matter:
#   id, state, enabled, cron and retry, then exit_code, last_run and duration
#   after its first run, and running_since while it runs. Then prints the
#   output of its last run, or of the run in progress.
#
# ARGUMENTS
#   id   Check to print
#
# OPTIONS
#   --color      Print the property names in bold
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an id with no check
#
# SEE ALSO
#   recheck ls, recheck browse

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

SHOULD_COLOR="" # --color after show, "true" or ""

# ╭───
# │ Primitives
# ╰───

# print_property <name> <value>
# Print "<name>: <value>", the name in bold when SHOULD_COLOR is set.
print_property() {
  if [ -n "$SHOULD_COLOR" ]; then
    printf '\033[1m%s\033[0m: %s\n' "$1" "$2"
  else
    printf '%s: %s\n' "$1" "$2"
  fi
}

# ╭───
# │ Main
# ╰───

if [ "${1:-}" = "--color" ]; then
  SHOULD_COLOR="true"
  shift
fi

[ "$#" -eq 1 ] || _fail 2 '"show" needs one id'
guard_id "$1"

ENABLED="false"
if is_enabled "$1"; then
  ENABLED="true"
fi

PATTERN=$(find_cron_pattern "$1") || PATTERN="-"
RETRY=$(find_retry "$1") || RETRY="-"

# The file "last" is one line: time, state, exit code, seconds
LAST_TIME=""
LAST_STATE="no run yet"
if [ -f "$STATE_DIR/$1/last" ]; then
  IFS="$TAB" read -r LAST_TIME LAST_STATE LAST_CODE LAST_SECONDS \
    <"$STATE_DIR/$1/last" || true
fi

printf '%s\n' "---"
print_property "id" "$1"
print_property "state" "$LAST_STATE"
print_property "enabled" "$ENABLED"
# In quotes. Front matter is YAML, which reads a leading "*" as an alias
print_property "cron" "\"$PATTERN\""
print_property "retry" "\"$RETRY\""

if [ -n "$LAST_TIME" ]; then
  # 2026-10-08T12:00:03+0200 -> 2026-10-08 12:00:03
  CLOCK="${LAST_TIME#*T}"

  print_property "exit_code" "$LAST_CODE"
  print_property "last_run" "${LAST_TIME%%T*} ${CLOCK%[+-]*}"
  print_property "duration" "$LAST_SECONDS"
fi

OUTPUT_FILE="$STATE_DIR/$1/output"
if RUN_START=$(find_run_start "$1"); then
  print_property "running_since" "$RUN_START"

  if [ -f "$OUTPUT_FILE.new" ]; then
    OUTPUT_FILE="$OUTPUT_FILE.new"
  fi
fi

printf '%s\n' "---"

if [ -f "$OUTPUT_FILE" ]; then
  printf '\n'
  cat -- "$OUTPUT_FILE"
fi

exit 0
