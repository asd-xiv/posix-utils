#!/bin/sh

# recheck enable <id>...
#
# Remove the "_" from the file name of each check, then sync.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/guard.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

# ╭───
# │ Main
# ╰───

[ "$#" -gt 0 ] || _fail 2 '"enable" needs at least one id'

# Guard everything before the first rename, so a failure changes nothing
guard_id "$@"
for ID in "$@"; do
  find_cron_pattern "$ID" >/dev/null \
    || _fail 3 -v id "$ID" "No valid cron pattern in a '# CRON:' line"
done
_require_cmd crontab awk
guard_recheck_file

for ID in "$@"; do
  is_enabled "$ID" && continue
  mv -- "$CHECKS_DIR/_$ID" "$CHECKS_DIR/$ID"
  _ok -v id "$ID" "Check enabled"
done

"$RECHECK_FILE" sync

exit 0
