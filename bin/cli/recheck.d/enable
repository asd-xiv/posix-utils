#!/bin/sh

# recheck enable [id...]
#
# Remove the "_" from the file name of each check, then sync.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/checks.sh"

# ╭───
# │ Primitives
# ╰───

# find_disabled_ids
# Print the id of every disabled check, one per line.
find_disabled_ids() {
  for disabled_id in $(find_ids); do
    if ! is_enabled "$disabled_id"; then
      printf '%s\n' "$disabled_id"
    fi
  done
}

# ╭───
# │ Commands
# ╰───

# enable_checks <id>...
# Remove the "_" from the file name of each check, then sync.
enable_checks() {
  # Guard everything before the first rename, so a failure changes nothing
  guard_id "$@"
  for enable_id in "$@"; do
    find_cron_pattern "$enable_id" >/dev/null \
      || _fail 3 -v id "$enable_id" "No valid cron pattern in a '# CRON:' line"
  done
  guard_sync

  for enable_id in "$@"; do
    is_enabled "$enable_id" && continue
    mv -- "$CHECKS_DIR/_$enable_id" "$CHECKS_DIR/$enable_id"
    _ok -v id "$enable_id" "Check enabled"
  done

  "$RECHECK_FILE" sync
}

# ╭───
# │ Main
# ╰───

if [ "$#" -eq 0 ] && [ -t 0 ]; then
  PICKABLE_IDS=$(find_disabled_ids)

  if [ -z "$PICKABLE_IDS" ]; then
    _warn "Nothing to enable"
    exit 4
  fi

  _require_cmd fzf

  # Not written inside 'set --', which ignores the status of a
  # substitution. A lone assignment fails with the status of pick_ids,
  # and 'set -e' ends the script with it
  PICKED_IDS=$(printf '%s\n' "$PICKABLE_IDS" | pick_ids)

  # shellcheck disable=SC2086 # ids are slugs, safe to split
  set -- $PICKED_IDS
fi

[ "$#" -gt 0 ] || _fail 2 '"enable" needs at least one id'

enable_checks "$@"

exit 0
