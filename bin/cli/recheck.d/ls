#!/bin/sh

# recheck ls [--cron | --color | --columns <names>]
#
# Print every check: state, on or off, id, cron pattern, last line. With
# --cron, print the crontab line of each enabled check with a valid cron
# pattern. With --color, print for a person. With --columns, print only the
# named columns, in the order of <names>.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/checks.sh"

MODE=""        # --cron or --color, "" for the plain list
HAS_COLUMNS="" # "true" once the caller passes --columns
# --columns, the names of the columns of list_checks, with a comma between them
COLUMN_NAMES="state,switch,id,pattern,last-line"

# ╭───
# │ Primitives
# ╰───

# find_last_line <id>
# From the output of a check, print the last line that holds more than spaces
# and tabs, with each tab as a space. Print "-" when the check has no output
# file or the file has no such line.
find_last_line() {
  last_file="$STATE_DIR/$1/output"

  if [ ! -f "$last_file" ]; then
    printf '%s' "-"
    return 0
  fi

  awk '
    /[^ \t]/ { line = $0 }
    END {
      gsub(/\t/, " ", line)
      printf "%s", (line == "" ? "-" : line)
    }' "$last_file"
}

# guard_columns <names>
# Exit 2 unless <names> is a list of column names with a comma between them.
# The names are state, switch, id, pattern and last-line.
guard_columns() {
  # An empty name: empty <names>, a comma at either end or two commas in a row
  case "$1" in
    "" | ,* | *, | *,,*) _fail 2 -v column "" "Not a column" ;;
  esac

  guard_rest="$1"
  while [ -n "$guard_rest" ]; do
    guard_name="${guard_rest%%,*}"

    case "$guard_name" in
      state | switch | id | pattern | last-line) ;;
      *) _fail 2 -v column "$guard_name" "Not a column" ;;
    esac

    case "$guard_rest" in
      *,*) guard_rest="${guard_rest#*,}" ;;
      *) guard_rest="" ;;
    esac
  done

  return 0
}

# list_checks
# Print the columns named in COLUMN_NAMES for every check, with a tab between
# the columns. Find a value only when its column is named.
list_checks() {
  for list_id in $(find_ids); do
    list_rest="$COLUMN_NAMES"
    list_delimiter=""

    while [ -n "$list_rest" ]; do
      list_name="${list_rest%%,*}"

      case "$list_name" in
        state) list_value=$(find_state "$list_id") ;;
        switch)
          list_value="off"
          if is_enabled "$list_id"; then
            list_value="on"
          fi
          ;;
        id) list_value="$list_id" ;;
        pattern) list_value=$(find_cron_pattern "$list_id") || list_value="-" ;;
        last-line) list_value=$(find_last_line "$list_id") ;;
      esac

      # printf takes the tab and the value as arguments, so it never reads them
      # as a format
      printf '%s%s' "$list_delimiter" "$list_value"
      list_delimiter="$TAB"

      case "$list_rest" in
        *,*) list_rest="${list_rest#*,}" ;;
        *) list_rest="" ;;
      esac
    done

    printf '\n'
  done

  return 0
}

# list_colored_checks
# Print every check for a person: a dot in the color of its state, on or off,
# id. The dot is blue while the check runs. The colors are the terminal's
# own, so they follow its palette.
list_colored_checks() {
  for color_id in $(find_ids); do
    case "$(find_state "$color_id")" in
      green) color_code=32 ;;
      red) color_code=31 ;;
      broken) color_code=33 ;;
      *) color_code=90 ;;
    esac

    # Only the color says "running". The browser knows a row by its id, which
    # it reads as the third column, so the id must stay the third column
    if is_running "$color_id"; then
      color_code=34
    fi

    # The space after "on" keeps the ids in one column
    color_switch="[off]"
    if is_enabled "$color_id"; then
      color_switch="[on] "
    fi

    printf '\033[%sm●\033[0m %s %s\n' \
      "$color_code" "$color_switch" "$color_id"
  done

  return 0
}

# ╭───
# │ Main
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    --cron | --color)
      [ -z "$MODE" ] || _fail 2 '"ls" takes at most one of --cron or --color'
      MODE="${1#--}"
      shift
      ;;
    --columns)
      [ "$#" -ge 2 ] || _fail 2 "--columns needs names"
      COLUMN_NAMES="$2"
      HAS_COLUMNS="true"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
    *) break ;;
  esac
done

[ "$#" -eq 0 ] || _fail 2 -v argument "$1" '"ls" takes only flags'

# --cron prints crontab lines. The browser reads the id from each --color row.
# So neither --cron nor --color works with --columns
if [ -n "$HAS_COLUMNS" ] && [ -n "$MODE" ]; then
  _fail 2 '"ls" takes --columns only without --cron or --color'
fi

guard_columns "$COLUMN_NAMES"

case "$MODE" in
  "") list_checks ;;
  # list_cron_lines returns 1 after a warning, which is no failure for ls
  cron) list_cron_lines || true ;;
  color) list_colored_checks ;;
esac

exit 0
