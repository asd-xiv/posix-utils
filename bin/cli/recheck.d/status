#!/bin/sh

# recheck status
#
# Print the count of enabled checks per state, then how many are running now,
# as "<green> <red> <broken> <running>". A running check also counts under the
# state of its last run. Exit 1 when an enabled check is red or broken.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/checks.sh"

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"status" takes no arguments'

GREEN_COUNT=0
RED_COUNT=0
BROKEN_COUNT=0
RUNNING_COUNT=0

for ID in $(find_enabled_ids); do
  if is_running "$ID"; then
    RUNNING_COUNT=$((RUNNING_COUNT + 1))
  fi

  case "$(find_state "$ID")" in
    green) GREEN_COUNT=$((GREEN_COUNT + 1)) ;;
    red) RED_COUNT=$((RED_COUNT + 1)) ;;
    broken) BROKEN_COUNT=$((BROKEN_COUNT + 1)) ;;
  esac
done

printf '%s %s %s %s\n' \
  "$GREEN_COUNT" "$RED_COUNT" "$BROKEN_COUNT" "$RUNNING_COUNT"

if [ "$RED_COUNT" -gt 0 ] || [ "$BROKEN_COUNT" -gt 0 ]; then
  exit 1
fi

exit 0
