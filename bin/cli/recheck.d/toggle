#!/bin/sh

# NAME
#   recheck toggle - Disable each enabled check, enable each disabled one
#
# SYNOPSIS
#   recheck toggle <id>...
#
# DESCRIPTION
#   Runs disable on each check that is enabled, and enable on each that is
#   not. Both sync.
#
# ARGUMENTS
#   id   Check to toggle. Repeatable
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   0   Done
#   2   Invalid usage, eg. an id with no check
#
#   Every other code comes from enable or disable.
#
# SEE ALSO
#   recheck enable, recheck disable

# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/help.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
. "$SCRIPT_DIR/../../lib/os.sh"
. "$SCRIPT_DIR/lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
esac

# ╭───
# │ Main
# ╰───

[ "$#" -gt 0 ] || _fail 2 '"toggle" needs at least one id'
guard_id "$@"

for ID in "$@"; do
  if is_enabled "$ID"; then
    "$RECHECK_FILE" disable "$ID"
  else
    "$RECHECK_FILE" enable "$ID"
  fi
done

exit 0
