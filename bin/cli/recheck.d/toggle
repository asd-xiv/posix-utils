#!/bin/sh

# recheck toggle <id>...
#
# Disable each check that is enabled, enable each that is not.
# recheck runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/checks.sh"

# ╭───
# │ Main
# ╰───

[ "$#" -gt 0 ] || _fail 2 '"toggle" needs at least one id'
guard_id "$@"

for ID in "$@"; do
  if is_enabled "$ID"; then
    "$RECHECK_FILE" disable "$ID"
  else
    "$RECHECK_FILE" enable "$ID"
  fi
done

exit 0
