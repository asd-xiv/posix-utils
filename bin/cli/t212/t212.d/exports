#!/bin/sh

set -eu

# NAME
#   t212 exports - Print each CSV report requested and its status
#
# SYNOPSIS
#   t212 [--live] exports
#
# SEE ALSO
#   curl, jq

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/../../../lib.sh"
. "$_SCRIPT_DIR/lib.sh"

_parse_args "$0" 0 "$@"
_use_account
_require_cmd curl jq
_TEMP_DIR=$(_create_temp_dir t212)
_delete_on_exit "$_TEMP_DIR"

_print_api /api/v0/equity/history/exports

exit 0
