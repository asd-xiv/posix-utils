#!/bin/sh

set -eu

# NAME
#   t212 pies - Print every pie, or the pie <id> with its instruments
#
# SYNOPSIS
#   t212 [--live] pies [id]
#
# ARGUMENTS
#   id   Id of a pie, a positive integer
#
# EXAMPLE
#   t212 pies
#   t212 pies 42

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/lib.sh"

_parse_args "$0" 1 "$@"
_guard_id "$_POSITIONAL"

_use_account
_create_temp_dir

_print_api "/api/v0/equity/pies${_POSITIONAL:+/$_POSITIONAL}"

exit 0
