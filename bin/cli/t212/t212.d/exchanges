#!/bin/sh

set -eu

# NAME
#   t212 exchanges - Print every exchange and its working hours
#
# SYNOPSIS
#   t212 [--live] exchanges
#
# DESCRIPTION
#   Caches the answer for 10 minutes. The API updates the exchanges every
#   10 minutes. It allows one call per 30 s.
#
# ENVIRONMENT
#   XDG_CACHE_HOME   Parent of the cache (default: ~/.cache)
#
# FILES
#   ~/.cache/t212/<demo|live>/exchanges.json   The cached answer
#   ~/.cache/t212/<demo|live>/exchanges.time   When t212 cached it, as a Unix time
#
# EXAMPLE
#   t212 exchanges | jq length
#
# SEE ALSO
#   curl, jq

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/../../../lib.sh"
. "$_SCRIPT_DIR/lib.sh"

_parse_args "$0" 0 "$@"
_use_account
_require_cmd curl jq
_TEMP_DIR=$(_create_temp_dir t212)
_delete_on_exit "$_TEMP_DIR"

_get_cached /api/v0/equity/metadata/exchanges

exit 0
