#!/bin/sh

set -eu

# NAME
#   t212 sync - Copy the history of the account into its database
#
# SYNOPSIS
#   t212 [--live] sync [orders|dividends|transactions|snapshot]
#
# DESCRIPTION
#   Copies the filled orders, dividends and transactions, then takes a
#   snapshot. With a kind, does only that kind. Prints how many rows sync
#   added per kind, as one JSON object. For snapshot, the count is positions.
#
#   Reads the pages newest first. The first sync of a kind reads every page,
#   about 1,000 rows a minute, and saves its place after each page. A later
#   sync reads pages until it reaches a row the database has. Then, if the
#   first sync stopped halfway, it resumes from the saved place.
#
#   A snapshot saves each position and the summary of the account, with the
#   time the API answered, in 2 calls. The API returns only the current
#   positions, so run "t212 sync snapshot" on a schedule, eg. hourly with
#   cron, to keep the value of the account over time.
#
#   Each run of sync gets an id, in the table syncs. A history row keeps the
#   id of the run that first saw it, a snapshot the id of its run. When the
#   run ends, syncs keeps its exit code, as "t212 --help" lists them.
#
#   First, sync brings the database to the newest version. It applies each
#   migration the database lacks, in order, then creates the views again. To
#   query the database, see "t212 sql --help".
#
# ENVIRONMENT
#   XDG_DATA_HOME   Parent of the databases (default: ~/.local/share)
#
# FILES
#   ~/.local/share/t212/<demo|live>.db   The database of the account
#
# EXAMPLE
#   t212 --live sync
#   t212 sync dividends
#
# SEE ALSO
#   curl, jq, sqlite3 3.38 or newer

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/../../../lib.sh"
. "$_SCRIPT_DIR/lib.sh"
# shellcheck source=db/db.sh
. "$_SCRIPT_DIR/db/db.sh"

# ╭───
# │ Composers
# ╰───

# _insert_until_known <db-file> <kind> <sync-id> <page-file>
#
# Insert the items of <page-file> into the table <kind>.
#
# RETURNS
#   1   The page has a row the table has, so _walk_pages stops
# shellcheck disable=SC2329 # _walk_pages calls it
_insert_until_known() {
  # _walk_pages reads the status, so set -e is off here. exit passes on the
  # status of a failed _insert_page
  iuk_counts=$(_insert_page "$1" "$2" "$3" "$4") || exit

  if [ "${iuk_counts% *}" -lt "${iuk_counts#* }" ]; then
    return 1
  fi
}

# _insert_and_save <db-file> <kind> <sync-id> <page-file>
#
# Insert the items of <page-file> into the table <kind>, and save the next
# page path as the place to resume.
# shellcheck disable=SC2329 # _walk_pages calls it
_insert_and_save() {
  _insert_page "$1" "$2" "$3" "$4" --save-next >/dev/null
  _debug -v kind "$2" "Synced a page"
}

# _take_snapshot <sync-id>
#
# Insert each position and the summary of the account, with <sync-id> and
# the time the API answered each. Print how many positions.
#
# EXIT
#   3   sqlite3 failed
#   4   The API answered with no positions array, no summary or no Date
_take_snapshot() {
  _call_api /api/v0/equity/positions "$_TEMP_DIR/positions"
  _call_api /api/v0/equity/account/summary "$_TEMP_DIR/summary"

  jq -e 'type == "array"' -- "$_TEMP_DIR/positions" >/dev/null 2>&1 \
    || _fail 4 "The API answered with no positions"
  jq -e 'type == "object" and has("totalValue")' -- "$_TEMP_DIR/summary" \
    >/dev/null 2>&1 || _fail 4 "The API answered with no summary"

  # set -e ignores a failed $(...) inside the arguments of a call, so read
  # each time apart
  ts_positions_at=$(_get_fetched_at "$_TEMP_DIR/positions.headers")
  ts_summary_at=$(_get_fetched_at "$_TEMP_DIR/summary.headers")

  _insert_snapshot "$_DB_FILE" "$1" \
    "$_TEMP_DIR/positions" "$ts_positions_at" \
    "$_TEMP_DIR/summary" "$ts_summary_at"
}

# _finish_sync
#
# Save the exit code of the script and the time it ended to the row of
# _SYNC_ID in syncs. Runs on EXIT, so it saves a failed run too. Does nothing
# before the run has a row.
# shellcheck disable=SC2329 # _delete_on_exit calls it
_finish_sync() {
  # The first command, since every command sets $?
  fs_exit_code=$?

  if [ -n "${_SYNC_ID:-}" ]; then
    _run_sql "$_DB_FILE" "UPDATE syncs
      SET finished_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now'),
        exit_code = $fs_exit_code
      WHERE id = $_SYNC_ID;" \
      || _warn -v sync_id "$_SYNC_ID" "Could not save the exit code"
  fi
}

# _sync_kind <kind> <sync-id>
#
# Insert the rows of <kind> the database lacks, each with <sync-id>, and
# print how many. A first sync reads every page and saves its place after
# each one. A later sync reads pages until one has a row the database has,
# then resumes a first sync that stopped halfway.
_sync_kind() {
  sk_first_path="/api/v0/equity/history/$1?limit=50"
  sk_before=$(_run_sql "$_DB_FILE" "SELECT count(*) FROM $1;") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

  # The saved place of <kind>: empty when no sync has read <kind>, "done"
  # when its first sync reached the oldest page, otherwise the next page path
  sk_resume_path=$(_run_sql "$_DB_FILE" \
    "SELECT coalesce(next_page_path, 'done') FROM cursors WHERE kind = '$1';") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

  if [ -z "$sk_resume_path" ]; then
    sk_resume_path="$sk_first_path"
  else
    _walk_pages "$sk_first_path" _insert_until_known "$_DB_FILE" "$1" "$2"
  fi

  if [ "$sk_resume_path" = "done" ]; then
    sk_resume_path=""
  fi
  _walk_pages "$sk_resume_path" _insert_and_save "$_DB_FILE" "$1" "$2"

  sk_after=$(_run_sql "$_DB_FILE" "SELECT count(*) FROM $1;") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"
  printf '%s\n' "$((sk_after - sk_before))"
}

# ╭───
# │ Bootstrap
# ╰───

_parse_args "$0" 1 "$@"

if [ -n "$_POSITIONAL" ] && [ "$_POSITIONAL" != "snapshot" ] \
  && ! _is_history_kind "$_POSITIONAL"; then
  _fail 2 -v sync "$_POSITIONAL" \
    "Use orders, dividends, transactions or snapshot"
fi

_use_account
_require_cmd curl jq sqlite3
_TEMP_DIR=$(_create_temp_dir t212)
_delete_on_exit "$_TEMP_DIR" _finish_sync

_DB_FILE=$(_get_db_file "$_ACCOUNT")

# ╭───
# │ Main
# ╰───

mkdir -p -- "$(dirname "$_DB_FILE")"
_migrate "$_DB_FILE" "$_SCRIPT_DIR/db"

# started_at and finished_at time the run by the clock of this machine.
# _finish_sync sets finished_at and exit_code
_SYNC_ID=$(_run_sql "$_DB_FILE" "
  INSERT INTO syncs (started_at) VALUES (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'));
  SELECT last_insert_rowid();") || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

_COUNTS=""
for _KIND in ${_POSITIONAL:-orders dividends transactions snapshot}; do
  _info -v kind "$_KIND" -v sync_id "$_SYNC_ID" "Syncing"
  if [ "$_KIND" = "snapshot" ]; then
    _COUNT=$(_take_snapshot "$_SYNC_ID")
  else
    _COUNT=$(_sync_kind "$_KIND" "$_SYNC_ID")
  fi
  _COUNTS="${_COUNTS:+$_COUNTS,}\"$_KIND\":$_COUNT"
done

printf '{%s}' "$_COUNTS" >"$_TEMP_DIR/body"
_print_json "$_TEMP_DIR/body"

exit 0
