#!/bin/sh

set -eu

# NAME
#   t212 sync - Copy the history of the account into its database
#
# SYNOPSIS
#   t212 [--live] sync [orders|dividends|transactions|snapshot]
#
# DESCRIPTION
#   Copies the filled orders, dividends and transactions, then takes a
#   snapshot, or does only the kind named. Prints how many rows sync added
#   per kind, as one JSON object.
#
#   Reads the pages newest first. The first sync of a kind reads every page,
#   about 1,000 rows a minute, and saves its place after each page. A later
#   sync reads pages until it reaches a row the database has. Then, if the
#   first sync stopped halfway, it resumes from the saved place.
#
#   A snapshot saves each position and the summary of the account, with the
#   time the API answered. The API returns only the current positions, so
#   run "t212 sync snapshot" on a schedule, eg. hourly with cron, to keep the
#   value of the account over time. It makes 2 calls.
#
#   Each run of sync gets an id, in the table syncs. A history row keeps the
#   id of the run that first saw it, a snapshot the id of its run.
#
#   Before the work, sync brings the database to the newest version: it
#   applies each file in t212.d/db/migrations that the database lacks, in
#   order, then creates the views again. To query the database, see
#   "t212 sql --help".
#
# ENVIRONMENT
#   XDG_DATA_HOME   Parent of the databases (default: ~/.local/share)
#
# FILES
#   ~/.local/share/t212/<demo|live>.db   The database of the account
#
# EXAMPLE
#   t212 --live sync
#   t212 sync dividends
#
# SEE ALSO
#   sqlite3 3.38 or newer

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/lib.sh"

# ╭───
# │ Primitives
# ╰───

# _migrate
#
# Apply each file in db/migrations/ whose number is above the user_version of
# the database, in order. Each runs in one transaction that also sets
# user_version to its number, so a migration is whole or absent. Then create
# the views again.
#
# EXIT
#   3   A migration or the views failed
_migrate() {
  mg_version=$(_run_sql "$_DB_FILE" "PRAGMA user_version;") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

  for mg_file in "$_SCRIPT_DIR"/db/migrations/[0-9][0-9][0-9]-*.sql; do
    [ -f "$mg_file" ] || continue

    # 002-create-syncs.sql gives 2. sed drops the leading zeros, which shell
    # arithmetic would read as octal
    mg_number=$(basename "$mg_file" | cut -c 1-3 | sed 's/^0*//')
    [ "${mg_number:-0}" -gt "$mg_version" ] || continue

    _run_sql "$_DB_FILE" "
      BEGIN;
      $(cat -- "$mg_file")
      PRAGMA user_version = $mg_number;
      COMMIT;" \
      || _fail 3 -v migration "$(basename "$mg_file")" "Migration failed"
    _info -v migration "$(basename "$mg_file")" "Applied"
  done

  _run_sql "$_DB_FILE" "$(cat -- "$_SCRIPT_DIR/db/views.sql")" \
    || _fail 3 -v db "$_DB_FILE" "Could not create the views"
}

# _insert_page <kind> <sync-id> <page-file> [--save-next]
#
# Insert the items of <page-file> that the table <kind> lacks, each with
# <sync-id>. Print "<inserted> <items>". Set the sync_id of the cursor of
# <kind> to <sync-id>. With --save-next, also set its next_page_path to the
# one of <page-file>, NULL on the last page. One transaction does it all, so a sync
# that stops never saves a place past the rows it inserted. sqlite3 reads the
# page once, into the temp table page.
#
# EXIT
#   3   sqlite3 failed
# shellcheck disable=SC2329 # the callbacks of _walk_pages call it
_insert_page() {
  ip_next="next_page_path"
  if [ "${4:-}" = "--save-next" ]; then
    ip_next="excluded.next_page_path"
  fi

  # An INSERT ... SELECT with ON CONFLICT needs a WHERE, or SQLite reads ON
  # as part of a join
  _run_sql "$_DB_FILE" "
    BEGIN;
    CREATE TEMP TABLE page AS
      SELECT CAST(readfile($(_quote_sql "$3")) AS TEXT) AS json;
    INSERT OR IGNORE INTO $1 (raw, sync_id)
      SELECT value, $2 FROM page, json_each(page.json, '\$.items');
    SELECT changes() || ' ' || json_array_length(json, '\$.items') FROM page;
    INSERT INTO cursors (kind, next_page_path, sync_id)
      SELECT '$1', json ->> '\$.nextPagePath', $2 FROM page
      WHERE true
      ON CONFLICT (kind) DO UPDATE
        SET next_page_path = $ip_next, sync_id = excluded.sync_id;
    COMMIT;" || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"
}

# _insert_until_known <kind> <sync-id> <page-file>
#
# Insert the items of <page-file> into the table <kind>.
#
# RETURNS
#   1   The page has a row the table has, so _walk_pages stops
# shellcheck disable=SC2329 # _walk_pages calls it
_insert_until_known() {
  # _walk_pages reads the status, so set -e is off here. exit passes on the
  # status of a failed _insert_page
  iuk_counts=$(_insert_page "$1" "$2" "$3") || exit

  if [ "${iuk_counts% *}" -lt "${iuk_counts#* }" ]; then
    return 1
  fi
}

# _insert_and_save <kind> <sync-id> <page-file>
#
# Insert the items of <page-file> into the table <kind>, and save the next
# page path as the place to resume.
# shellcheck disable=SC2329 # _walk_pages calls it
_insert_and_save() {
  _insert_page "$1" "$2" "$3" --save-next >/dev/null
  _debug -v kind "$1" "Synced a page"
}

# _get_fetched_at
#
# Print the time of the last answer of the API, from its Date header, as ISO
# 8601 in UTC.
#
# EXIT
#   4   The answer has no Date header, or one of another shape
_get_fetched_at() {
  _to_iso_time "$(_find_header date "$_TEMP_DIR/headers")" \
    || _fail 4 "The API answered with no Date header"
}

# _take_snapshot <sync-id>
#
# Insert each position and the summary of the account, with <sync-id> and
# the time the API answered each. Print how many positions. One transaction
# does it all, so a snapshot is whole or absent.
#
# EXIT
#   3   sqlite3 failed
#   4   The API answered with no positions array, no summary or no Date
_take_snapshot() {
  _call_api /api/v0/equity/positions "$_TEMP_DIR/positions"
  ts_positions_at=$(_get_fetched_at)
  _call_api /api/v0/equity/account/summary "$_TEMP_DIR/summary"
  ts_summary_at=$(_get_fetched_at)

  jq -e 'type == "array"' -- "$_TEMP_DIR/positions" >/dev/null 2>&1 \
    || _fail 4 "The API answered with no positions"
  jq -e 'type == "object" and has("totalValue")' -- "$_TEMP_DIR/summary" \
    >/dev/null 2>&1 || _fail 4 "The API answered with no summary"

  _run_sql "$_DB_FILE" "
    BEGIN;
    INSERT OR IGNORE INTO positions (sync_id, fetched_at, raw)
      SELECT $1, '$ts_positions_at', value
      FROM json_each(CAST(readfile($(_quote_sql "$_TEMP_DIR/positions")) AS TEXT));
    SELECT changes();
    INSERT OR IGNORE INTO summaries (sync_id, fetched_at, raw)
      VALUES ($1, '$ts_summary_at',
        CAST(readfile($(_quote_sql "$_TEMP_DIR/summary")) AS TEXT));
    COMMIT;" || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"
}

# _sync_kind <kind> <sync-id>
#
# Insert the rows of <kind> the database lacks, each with <sync-id>, and
# print how many. A first sync reads every page and saves its place after
# each one. A later sync reads pages until one has a row the database has,
# then resumes a first sync that stopped halfway.
_sync_kind() {
  sk_first_path="/api/v0/equity/history/$1?limit=50"
  sk_before=$(_run_sql "$_DB_FILE" "SELECT count(*) FROM $1;") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

  # The saved place of <kind>: empty when no sync has read <kind>, "done"
  # when its first sync reached the oldest page, otherwise the next page path
  sk_resume_path=$(_run_sql "$_DB_FILE" \
    "SELECT coalesce(next_page_path, 'done') FROM cursors WHERE kind = '$1';") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

  if [ -z "$sk_resume_path" ]; then
    sk_resume_path="$sk_first_path"
  else
    _walk_pages "$sk_first_path" _insert_until_known "$1" "$2"
  fi

  if [ "$sk_resume_path" = "done" ]; then
    sk_resume_path=""
  fi
  _walk_pages "$sk_resume_path" _insert_and_save "$1" "$2"

  sk_after=$(_run_sql "$_DB_FILE" "SELECT count(*) FROM $1;") \
    || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"
  printf '%s\n' "$((sk_after - sk_before))"
}

# ╭───
# │ Bootstrap
# ╰───

_parse_args "$0" 1 "$@"

if [ -n "$_POSITIONAL" ] && [ "$_POSITIONAL" != "snapshot" ] \
  && ! _is_history_kind "$_POSITIONAL"; then
  _fail 2 -v sync "$_POSITIONAL" \
    "Use orders, dividends, transactions or snapshot"
fi

_use_account
_require_cmd sqlite3
_create_temp_dir

_DB_FILE=$(_get_db_file "$_ACCOUNT")

# ╭───
# │ Main
# ╰───

mkdir -p -- "$(dirname "$_DB_FILE")"
_migrate

# started_at and finished_at time the run by the clock of this machine
_SYNC_ID=$(_run_sql "$_DB_FILE" "
  INSERT INTO syncs (started_at) VALUES (strftime('%Y-%m-%dT%H:%M:%SZ', 'now'));
  SELECT last_insert_rowid();") || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

_COUNTS=""
for _KIND in ${_POSITIONAL:-orders dividends transactions snapshot}; do
  _info -v kind "$_KIND" -v sync_id "$_SYNC_ID" "Syncing"
  if [ "$_KIND" = "snapshot" ]; then
    _COUNT=$(_take_snapshot "$_SYNC_ID")
  else
    _COUNT=$(_sync_kind "$_KIND" "$_SYNC_ID")
  fi
  _COUNTS="${_COUNTS:+$_COUNTS,}\"$_KIND\":$_COUNT"
done

_run_sql "$_DB_FILE" "UPDATE syncs
  SET finished_at = strftime('%Y-%m-%dT%H:%M:%SZ', 'now') WHERE id = $_SYNC_ID;" \
  || _fail 3 -v db "$_DB_FILE" "sqlite3 failed"

printf '{%s}' "$_COUNTS" >"$_TEMP_DIR/body"
_print_json "$_TEMP_DIR/body"

exit 0
