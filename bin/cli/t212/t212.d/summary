#!/bin/sh

set -eu

# NAME
#   t212 summary - Print the cash and investment totals of the account
#
# SYNOPSIS
#   t212 [--live] summary

# t212 runs this file by its path, and exports LOG_NAMESPACE, LOG_LEVEL and
# _T212_ACCOUNT
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/lib.sh"

_parse_args "$0" 0 "$@"
_use_account
_create_temp_dir

_print_api /api/v0/equity/account/summary

exit 0
