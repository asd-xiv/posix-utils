#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../../tools/test-lib.sh"
. "$SCRIPT_DIR/../../../lib/log.sh"
. "$SCRIPT_DIR/../../../lib/validation.sh"
. "$SCRIPT_DIR/../../../lib/guard.sh"
. "$SCRIPT_DIR/../../../lib/help.sh"
. "$SCRIPT_DIR/../../../lib/text.sh"
# shellcheck source=../t212.d/lib.sh
. "$SCRIPT_DIR/../t212.d/lib.sh"

_describe "t212.d/lib.sh :: _quote_sql :: valid"

_test 'given [a path] should [print it between single quotes]'
actual() { _quote_sql '/tmp/t212.ab12/page'; }
_expect equal actual.stdout "'/tmp/t212.ab12/page'"

_describe "t212.d/lib.sh :: _quote_sql :: edge"

_test 'given [a text with single quotes] should [double each one]'
actual() { _quote_sql "it's 'x'"; }
_expect equal actual.stdout "'it''s ''x'''"

_test 'given [an empty text] should [print two quotes]'
actual() { _quote_sql ''; }
_expect equal actual.stdout "''"
