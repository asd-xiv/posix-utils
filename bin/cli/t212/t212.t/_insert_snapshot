#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../../tools/test-lib.sh"
. "$SCRIPT_DIR/../../../lib/log.sh"
. "$SCRIPT_DIR/../../../lib/validation.sh"
. "$SCRIPT_DIR/../../../lib/guard.sh"
. "$SCRIPT_DIR/../../../lib/help.sh"
. "$SCRIPT_DIR/../../../lib/text.sh"
# shellcheck source=../t212.d/lib.sh
. "$SCRIPT_DIR/../t212.d/lib.sh"
# shellcheck source=../t212.d/db/lib.sh
. "$SCRIPT_DIR/../t212.d/db/lib.sh"
. "$SCRIPT_DIR/sandbox.sh"

command -v sqlite3 >/dev/null 2>&1 || _skip_all "sqlite3 is not installed"

# A database at the newest version, with the sync 1, and the answers of
# sandbox.sh in positions and summary
build_db() {
  _migrate db "$SCRIPT_DIR/../t212.d/db" 2>/dev/null
  _run_sql db "INSERT INTO syncs (id, started_at) VALUES (1, 'x');"
  printf '%s' "$_POSITIONS" >positions
  printf '%s' "$_SUMMARY" >summary
}

_describe "t212.d/db/lib.sh :: _insert_snapshot :: valid"

before_each() { build_db; }

_test 'given [two positions and a summary] should [save each with the sync id and its time, and print 2]'
actual() {
  _insert_snapshot db 1 positions 2026-11-08T14:27:46Z summary 2026-11-08T14:27:51Z
  _run_sql db "SELECT sync_id, fetched_at, ticker FROM positions ORDER BY ticker;
    SELECT sync_id, fetched_at, total_value FROM summaries;"
}
_expect equal actual.exit 0
_expect equal actual.stdout '2
1|2026-11-08T14:27:46Z|JPM_US_EQ
1|2026-11-08T14:27:46Z|KO_US_EQ
1|2026-11-08T14:27:51Z|1092.0'

_describe "t212.d/db/lib.sh :: _insert_snapshot :: edge"

before_each() { build_db; }

_test 'given [no positions] should [save the summary and print 0]'
actual() {
  printf '[]' >positions
  _insert_snapshot db 1 positions x summary x
  _run_sql db "SELECT count(*) FROM summaries;"
}
_expect equal actual.stdout '0
1'

_describe "t212.d/db/lib.sh :: _insert_snapshot :: invalid"

before_each() { build_db; }

_test 'given [a summary that is not JSON] should [exit 3 and save no position]'
actual() {
  printf '<html>' >summary
  (_insert_snapshot db 1 positions x summary x >/dev/null) || {
    status=$?
    _run_sql db "SELECT count(*) FROM positions;"
    exit "$status"
  }
}
_expect equal actual.exit 3
_expect equal actual.stdout '0'
