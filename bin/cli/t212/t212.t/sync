#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../../tools/test-lib.sh"
. "$SCRIPT_DIR/sandbox.sh"

command -v sqlite3 >/dev/null 2>&1 || _skip_all "sqlite3 is not installed"

_describe "t212.d/sync :: sync :: valid"

before_each() { build_sandbox; }

_test 'given [a first sync of two pages] should [insert every row, print the count and mark the sync done]'
prepare() {
  add_answer 1 200 "$_PAGE_1"
  add_answer 2 200 "$_PAGE_2"
}
actual() {
  "$T212" sync transactions
  db "SELECT reference FROM transactions ORDER BY date_time"
  db "SELECT kind, next_page_path IS NULL FROM cursors"
}
_expect equal actual.exit 0
_expect equal actual.stdout '{"transactions":3}
a
b
c
transactions|1'

_test 'given [a later sync whose first page has a known row] should [insert the new rows and stop there]'
prepare() {
  add_answer 1 200 "$_PAGE_1"
  add_answer 2 200 "$_PAGE_2"
  add_answer 3 200 '{"items":[{"reference":"d","type":"FEE","amount":-2,"currency":"USD","dateTime":"2026-01-04T00:00:00.000Z"},{"reference":"c","type":"FEE","amount":-1,"currency":"USD","dateTime":"2026-01-03T00:00:00.000Z"}],"nextPagePath":"/api/v0/equity/history/transactions?limit=50&cursor=b&time=2026-01-02T00:00:00.000Z"}'
}
actual() {
  "$T212" sync transactions >/dev/null
  "$T212" sync transactions
  wc -l <calls.log | tr -d ' '
}
_expect equal actual.exit 0
_expect equal actual.stdout '{"transactions":1}
3'

_test 'given [no kind] should [sync orders, dividends and transactions, then take a snapshot]'
prepare() {
  add_answer 1 200 '{"items":[{"order":{"id":7,"ticker":"AAPL_US_EQ"},"fill":{"id":9}}],"nextPagePath":null}'
  add_answer 2 200 '{"items":[],"nextPagePath":null}'
  add_answer 3 200 '{"items":[],"nextPagePath":null}'
  add_answer 4 200 "$_POSITIONS"
  add_answer 5 200 "$_SUMMARY"
}
actual() {
  "$T212" sync
  db "SELECT order_id, ticker FROM orders"
}
_expect equal actual.exit 0
_expect equal actual.stdout '{"orders":1,"dividends":0,"transactions":0,"snapshot":2}
7|AAPL_US_EQ'

_test 'given [snapshot] should [save each position and the summary, with the sync id and the Date of each answer]'
prepare() {
  add_answer 1 200 "$_POSITIONS" 'Date: Sun, 08 Nov 2026 14:27:46 GMT'
  add_answer 2 200 "$_SUMMARY" 'Date: Sun, 08 Nov 2026 14:27:51 GMT'
}
actual() {
  "$T212" sync snapshot
  db "SELECT sync_id, fetched_at, ticker, current_value FROM positions ORDER BY ticker"
  db "SELECT sync_id, fetched_at, total_value, cash FROM summaries"
  db "SELECT id, exit_code, finished_at IS NOT NULL FROM syncs"
  cut -f 1 calls.log
}
_expect equal actual.exit 0
_expect equal actual.stdout '{"snapshot":2}
1|2026-11-08T14:27:46Z|JPM_US_EQ|670.0
1|2026-11-08T14:27:46Z|KO_US_EQ|380.0
1|2026-11-08T14:27:51Z|1092.0|42.0
1|0|1
https://demo.trading212.com/api/v0/equity/positions
https://demo.trading212.com/api/v0/equity/account/summary'

_describe "t212.d/sync :: sync :: edge"

before_each() { build_sandbox; }

_test 'given [a first sync that fails on page 2] should [resume from page 2 on the next sync]'
prepare() {
  add_answer 1 200 "$_PAGE_1"
  add_answer 2 500 '{}'
  add_answer 3 200 "$_PAGE_1"
  add_answer 4 200 "$_PAGE_2"
}
actual() {
  "$T212" sync transactions || printf 'exit %s\n' "$?"
  db "SELECT next_page_path FROM cursors"
  "$T212" sync transactions
  cut -f 1 calls.log
}
_expect equal actual.exit 0
_expect equal actual.stdout 'exit 4
/api/v0/equity/history/transactions?limit=50&cursor=a&time=2026-01-01T00:00:00.000Z
{"transactions":1}
https://demo.trading212.com/api/v0/equity/history/transactions?limit=50
https://demo.trading212.com/api/v0/equity/history/transactions?limit=50&cursor=a&time=2026-01-01T00:00:00.000Z
https://demo.trading212.com/api/v0/equity/history/transactions?limit=50
https://demo.trading212.com/api/v0/equity/history/transactions?limit=50&cursor=a&time=2026-01-01T00:00:00.000Z'

_describe "t212.d/sync :: sync :: invalid"

before_each() { build_sandbox; }

_test 'given [a sync that fails halfway] should [save its exit code and the time it ended]'
prepare() {
  add_answer 1 200 "$_PAGE_1"
  add_answer 2 500 '{}'
}
actual() {
  "$T212" sync transactions || printf 'exit %s\n' "$?"
  db "SELECT id, exit_code, finished_at IS NOT NULL FROM syncs"
}
_expect equal actual.stdout 'exit 4
1|4|1'

_test 'given [a snapshot answer whose Date is not a date] should [exit 4 and save nothing]'
prepare() {
  add_answer 1 200 "$_POSITIONS" 'Date: soon'
  add_answer 2 200 "$_SUMMARY"
}
actual() {
  "$T212" sync snapshot || printf 'exit %s\n' "$?"
  db "SELECT count(*) FROM positions"
}
_expect equal actual.stdout 'exit 4
0'
_expect contain actual.stderr 'The API answered with no Date'

_test 'given [a snapshot whose positions are not an array] should [exit 4 and save nothing]'
prepare() {
  add_answer 1 200 '{"items":[]}'
  add_answer 2 200 "$_SUMMARY"
}
actual() {
  "$T212" sync snapshot || printf 'exit %s\n' "$?"
  db "SELECT (SELECT count(*) FROM positions) + (SELECT count(*) FROM summaries)"
}
_expect equal actual.stdout 'exit 4
0'
_expect contain actual.stderr 'The API answered with no positions'
