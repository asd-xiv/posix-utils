#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../../tools/test-lib.sh"
. "$SCRIPT_DIR/../../../lib/log.sh"
. "$SCRIPT_DIR/../../../lib/validation.sh"
. "$SCRIPT_DIR/../../../lib/guard.sh"
. "$SCRIPT_DIR/../../../lib/help.sh"
. "$SCRIPT_DIR/../../../lib/text.sh"
# shellcheck source=../t212.d/lib.sh
. "$SCRIPT_DIR/../t212.d/lib.sh"
# shellcheck source=../t212.d/db/lib.sh
. "$SCRIPT_DIR/../t212.d/db/lib.sh"
. "$SCRIPT_DIR/sandbox.sh"

command -v sqlite3 >/dev/null 2>&1 || _skip_all "sqlite3 is not installed"

# A database at the newest version, with the syncs 1 and 2, and the pages of
# sandbox.sh in page-1 and page-2
build_db() {
  _migrate db "$SCRIPT_DIR/../t212.d/db" 2>/dev/null
  _run_sql db "INSERT INTO syncs (id, started_at) VALUES (1, 'x'), (2, 'x');"
  printf '%s' "$_PAGE_1" >page-1
  printf '%s' "$_PAGE_2" >page-2
}

_describe "t212.d/db/lib.sh :: _insert_page :: valid"

before_each() { build_db; }

_test 'given [a new page] should [insert each item with the sync id, and print the inserted and item counts]'
actual() {
  _insert_page db transactions 1 page-1
  _run_sql db "SELECT reference, sync_id FROM transactions ORDER BY reference;"
}
_expect equal actual.exit 0
_expect equal actual.stdout '2 2
b|1
c|1'

_test 'given [--save-next] should [save the next page path of the page]'
actual() {
  _insert_page db transactions 1 page-1 --save-next >/dev/null
  _run_sql db "SELECT kind, next_page_path, sync_id FROM cursors;"
}
_expect equal actual.stdout 'transactions|/api/v0/equity/history/transactions?limit=50&cursor=a&time=2026-01-01T00:00:00.000Z|1'

_describe "t212.d/db/lib.sh :: _insert_page :: edge"

before_each() { build_db; }

_test 'given [a page with a known row] should [keep the sync id of the row, and count only the new one]'
prepare() { _insert_page db transactions 1 page-2 >/dev/null; }
actual() {
  printf '%s' '{"items":[{"reference":"b"},{"reference":"a"}],"nextPagePath":null}' >page
  _insert_page db transactions 2 page
  _run_sql db "SELECT reference, sync_id FROM transactions ORDER BY reference;"
}
_expect equal actual.stdout '1 2
a|1
b|2'

_test 'given [no --save-next] should [keep the saved place, and set the sync id of the cursor]'
prepare() { _insert_page db transactions 1 page-1 --save-next >/dev/null; }
actual() {
  _insert_page db transactions 2 page-2 >/dev/null
  _run_sql db "SELECT next_page_path, sync_id FROM cursors;"
}
_expect equal actual.stdout '/api/v0/equity/history/transactions?limit=50&cursor=a&time=2026-01-01T00:00:00.000Z|2'

_test 'given [the last page and --save-next] should [save NULL, the first sync is done]'
prepare() { _insert_page db transactions 1 page-1 --save-next >/dev/null; }
actual() {
  _insert_page db transactions 1 page-2 --save-next >/dev/null
  _run_sql db "SELECT next_page_path IS NULL FROM cursors;"
}
_expect equal actual.stdout '1'

_describe "t212.d/db/lib.sh :: _insert_page :: invalid"

before_each() { build_db; }

_test 'given [a kind with no table] should [exit 3 and save no place]'
actual() {
  (_insert_page db trades 1 page-1 --save-next) || {
    status=$?
    _run_sql db "SELECT count(*) FROM cursors;"
    exit "$status"
  }
}
_expect equal actual.exit 3
_expect equal actual.stdout '0'
