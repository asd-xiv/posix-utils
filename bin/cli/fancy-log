#!/bin/sh

set -eu

# NAME
#   fancy-log - Print a log line with its time, type and namespace, in color
#
# SYNOPSIS
#   fancy-log <type> [--no-color] [-v <key> <val>]... [--] <message>...
#   fancy-log -h | --help
#
# DESCRIPTION
#   The command form of _log. Use it from a shell or a pipeline that does not
#   source lib.sh. A script that sources lib.sh calls _log, or _debug, _info,
#   _ok, _warn and _error, instead. Each call saves one process.
#
#   <type> is a command word, so it comes before the flags. fancy-log reads
#   --help in place of <type>, and --no-color right after <type>. It passes
#   the rest, the -v pairs, -- and the message, to _log as written. -- ends
#   the flags, so a message that starts with - prints as written.
#
#   fancy-log prints the log line to stderr, never to stdout. stdout holds
#   only the result of the calling script.
#
# ARGUMENTS
#   type      One of error, warning, success, info, debug, in any case, or a
#             short form: err, warn, wrn, suc, succ, inf, dbg. success has no
#             level and always prints
#   message   Text to print, repeatable. fancy-log joins them with a space
#
# OPTIONS
#   -v, --var <key> <val>   Append a key=val pair after the message
#   --no-color              Print without color
#   -h, --help              Print this help
#
# ENVIRONMENT
#   LOG_LEVEL       Last level to print, in the order error < warning < info
#                   < debug, in any case or as a short form: err, warn, wrn,
#                   inf, dbg (default: info). An unknown level ends fancy-log
#                   with 2
#   LOG_NAMESPACE   Label printed before the message
#   NO_LOG_TIME     Hides the time when set and non-empty
#   NO_COLOR        Disables color when set and non-empty
#   TERM            Disables color when unset, empty or "dumb"
#
# EXAMPLE
#   fancy-log error -v param "bad" "Invalid parameter"
#   LOG_LEVEL=debug fancy-log debug "Cache miss"
#
# EXIT CODES
#   0   Printed the line, or hid it because the level of <type> comes after
#       LOG_LEVEL
#   2   Invalid usage: no <type>, no message, an unknown flag, an unknown
#       <type>, or a LOG_LEVEL that is not a level
#
# SEE ALSO
#   lib.sh

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../lib.sh"

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
esac

# _log guards the type: it exits 2 on an unknown type
LINE_TYPE="$1"
shift

# Strip the flags this command owns, pass the rest to _log untouched.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-color)
      NO_COLOR=1
      export NO_COLOR
      shift
      ;;
    # _log's own flag, forward it with the message
    -v | --var) break ;;
    --)
      # Leave -- in place: _log ends its pairs there too
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag"
      ;;
    *) break ;;
  esac
done

[ "$#" -eq 0 ] && _fail 2 "No message given"

_log "$LINE_TYPE" "$@"
