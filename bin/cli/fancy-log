#!/bin/sh

set -eu

# NAME
#   fancy-log - Dated, colored, namespaced log messages
#
# SYNOPSIS
#   fancy-log <level> [--no-color] [-v <key> <val>]... <message>...
#
# DESCRIPTION
#   The command form of the lib.sh logging helpers. Use it from shells and
#   pipelines that do not source lib.sh. A script that sources lib.sh calls
#   _info, _ok, _warn, _debug and _fail instead — one process fewer per line.
#
#   fancy-log owns --no-color and --help, which must come first. Everything
#   after them, -v pairs and the message, goes to the logger untouched.
#
#   All output goes to stderr, so stdout stays free for the script result.
#
# ARGUMENTS
#   level     - error, warning, success, info or debug
#   message   - text to print, last argument
#
# OPTIONS
#   -v, --var <key> <val>   Append a key=val pair after the message
#   --no-color              Print without color
#   -h, --help              Print this help
#
# ENVIRONMENT
#   LOG_LEVEL       Cut-off level to print (default: info)
#   LOG_NAMESPACE   Label printed before the message
#   NO_COLOR        If set, disables color
#
# EXAMPLE
#   fancy-log error -v param "bad" "Invalid parameter."
#   LOG_LEVEL=debug fancy-log debug "Cache miss."
#
# SEE ALSO
#   lib.sh

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../lib.sh"

# Both answers to "what is argument zero" live here. --help succeeds, an
# empty call does not.
case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 1
    ;;
esac

case "$1" in
  err | error) LEVEL="error" ;;
  warn | warning) LEVEL="warning" ;;
  succ | success) LEVEL="success" ;;
  info) LEVEL="info" ;;
  debug) LEVEL="debug" ;;
  *) _fail 2 -v level "$1" "Unknown level." ;;
esac
shift

# Strip the flags this command owns, pass the rest to _log untouched.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-color)
      NO_COLOR=1
      export NO_COLOR
      shift
      ;;
    # _log's own flag, forward it with the message
    -v | --var) break ;;
    --)
      shift
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag."
      ;;
    *) break ;;
  esac
done

[ "$#" -eq 0 ] && _fail 2 "No message given."

_log "$LEVEL" "$@"
