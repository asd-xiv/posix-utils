#!/bin/sh

# zettel create
#
# Open a new draft in Neovim, in this terminal. Line 1 is "# ", for the claim,
# and Neovim puts the cursor on line 3. When Neovim closes: run the on-update
# hook, then remove a draft with no text, keep a draft with no claim, hand a
# draft with a claim to "place". Keep the draft too when Neovim ends with an
# error. It needs a terminal on stdin: the caller opens one.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

TITLE="zettel :: editor"

# ╭───
# │ Primitives
# ╰───

# has_text <file>
# Return 0 when <file> holds a line that is not blank and not a bare "#".
has_text() {
  grep -q -v -e '^[[:space:]]*$' -e '^#[[:space:]]*$' -- "$1"
}

# ╭───
# │ Cleanup
# ╰───

# shellcheck disable=SC2329 # called by trap
cleanup() {
  _restore_title
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"create" takes no arguments'
_require_cmd nvim
[ -t 0 ] || _fail 3 '"create" needs a terminal'

DAY_DIR="$DRAFT_DIR/$(date +%y-%j)"
DRAFT_FILE="$DAY_DIR/$(date +%H%M%S).md"

# Neovim would write "# " over line 1 of a draft that is already there
[ ! -e "$DRAFT_FILE" ] \
  || _fail 3 -v path "$DRAFT_FILE" "A draft of this second exists, try again"

mkdir -p -- "$DAY_DIR"
# The file pickers of Neovim start in the folder Neovim starts in
cd -- "$NOTES_DIR"

# setline puts the three lines in the buffer, not in a file. With nomodified,
# ":q" closes a buffer the user did not touch and no file is left
# A waybar click finds an open editor by this title. Neovim with its 'title'
# option on renames the window, so it gets the same title
_set_title "$TITLE"
EDITOR_STATUS=0
nvim \
  -c "let &titlestring = '$TITLE'" \
  -c 'call setline(1, ["# ", "", ""])' \
  -c 'set nomodified' \
  -c 'normal G' \
  -c 'set spell' \
  -c startinsert \
  -- "$DRAFT_FILE" || EDITOR_STATUS=$?

# A draft came, changed or went. "place" runs the hook again after its work
run_hook "$UPDATE_HOOK_FILE"

if [ ! -f "$DRAFT_FILE" ] || ! has_text "$DRAFT_FILE"; then
  rm -f -- "$DRAFT_FILE"
  remove_empty_day_dir "$DAY_DIR"
  exit 0
fi

if [ "$EDITOR_STATUS" -ne 0 ]; then
  _info -v path "$DRAFT_FILE" "Neovim ended with an error, the draft stays"
  exit 0
fi

if ! find_claim "$DRAFT_FILE" >/dev/null; then
  _info -v path "$DRAFT_FILE" "No claim on line 1, the draft stays"
  exit 0
fi

PLACE_STATUS=0
"$PUBLIC_FILE" place "$DRAFT_FILE" || PLACE_STATUS=$?

# 4 is no parent picked. The draft stays, which is no failure for create
if [ "$PLACE_STATUS" -eq 4 ]; then
  exit 0
fi

exit "$PLACE_STATUS"
