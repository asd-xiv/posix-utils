#!/bin/sh

# zettel create
#
# Open a new draft in Neovim, in this terminal. Line 1 is "# ", for the claim,
# and Neovim puts the cursor on line 3. When Neovim closes, run sync: it
# removes a draft with no text, keeps a draft with no claim, and places a
# draft with a claim. When Neovim ends with an error, run "sync --no-place":
# the draft stays. Wait for Enter when sync printed a line. It needs a
# terminal on stdin: the caller opens one.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

TITLE="zettel :: editor"

# ╭───
# │ Cleanup
# ╰───

# shellcheck disable=SC2329 # called by trap
cleanup() {
  _restore_title
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"create" takes no arguments'
_require_cmd nvim
[ -t 0 ] || _fail 3 '"create" needs a terminal'

DRAFT_FILE="$(make_day_dir)/$(date +%H%M%S).md"

# Neovim would write "# " over line 1 of a draft that is already there
[ ! -e "$DRAFT_FILE" ] \
  || _fail 3 -v path "$DRAFT_FILE" "A draft of this second exists, try again"

# The file pickers of Neovim start in the folder Neovim starts in
cd -- "$NOTES_DIR"

# A waybar click finds an open editor by this title. Neovim renames the window
# when its 'title' option is on, so titlestring gives it the same title
_set_title "$TITLE"

# setline puts the three lines in the buffer, not in a file. With nomodified,
# ":q" closes a buffer the user did not touch and no file is left
EDITOR_STATUS=0
nvim \
  -c "let &titlestring = '$TITLE'" \
  -c 'call setline(1, ["# ", "", ""])' \
  -c 'set nomodified' \
  -c 'normal G' \
  -c 'set spell' \
  -c startinsert \
  -- "$DRAFT_FILE" || EDITOR_STATUS=$?

SYNC_FLAG=""
if [ "$EDITOR_STATUS" -ne 0 ]; then
  _info -v path "$DRAFT_FILE" "Neovim ended with an error, sync places no draft"
  SYNC_FLAG="--no-place"
fi

# sync places every draft with a claim, this one first: it is the newest.
# "sync --wait" waits when it printed a line. When sync fails, it ends before
# that wait, so create waits here
"$PUBLIC_FILE" sync ${SYNC_FLAG:+"$SYNC_FLAG"} --wait || {
  STATUS=$?
  _wait_for_enter
  exit "$STATUS"
}

exit 0
