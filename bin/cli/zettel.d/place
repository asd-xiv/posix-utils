#!/bin/sh

# zettel place <file>
#
# Place a draft: pick its parent in fzf, then write the next child id of that
# parent and the time into the front matter of the draft, as "id:" and
# "placed:". sync moves the draft into the box. The first zettel of a box gets
# the id 1, with no picker. An id in a draft counts as taken, so place never
# gives it again. Print the id. Exit 4 when no parent is picked. The picker
# needs fzf and a terminal on stdin: the caller opens one.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

# ╭───
# │ Main
# ╰───

[ "$#" -eq 1 ] || _fail 2 '"place" needs one draft file'

DRAFT_FILE="$1"
[ -f "$DRAFT_FILE" ] || _fail 2 -v path "$DRAFT_FILE" "Not a file"

CLAIM=$(find_claim "$DRAFT_FILE") \
  || _fail 2 -v path "$DRAFT_FILE" 'No claim: "# <claim>" on line 1, or after the front matter'
build_slug "$CLAIM" >/dev/null \
  || _fail 2 -v claim "$CLAIM" "The claim holds no letter a-z and no digit"

# sync moves a draft with an id, place has nothing to do
if DRAFT_ID=$(find_front_matter_value id "$DRAFT_FILE") \
  && _is folgezettel "$DRAFT_ID"; then
  _fail 2 -v path "$DRAFT_FILE" -v id "$DRAFT_ID" "The draft has an id already"
fi

ZETTELS=$(list_zettels)
IDS=$(printf '%s\n' "$ZETTELS" | cut -f 1)
PARENT_ID=""

if [ -n "$IDS" ]; then
  _require_cmd fzf
  [ -t 0 ] || _fail 3 '"place" needs a terminal'

  # Row 1 of the picker has no id, so the zettel on line N of IDS is row N + 1
  CURSOR_ROW=$(
    printf '%s\n' "$IDS" \
      | awk -v id="$(printf '%s\n' "$ZETTELS" | find_newest_ids 1)" \
        '$0 "" == id "" { print NR + 1; exit }'
  )

  # A row is what list_rows prints. fzf shows and searches the name, and prints
  # the whole row.
  #   {1}               the id under the cursor, empty on the row "+ no parent"
  #   load:pos          puts the cursor on the last zettel placed, once the
  #                     list is complete
  #   change:first      puts the cursor on the first match when the query
  #                     changes. fzf keeps the row number that pos set, and a
  #                     query with fewer matches leaves no row under the cursor
  #   --preview-label   the keys, on the bottom border of the preview. A
  #                     header is as narrow as the list and cuts them
  PICK_STATUS=0
  # shellcheck disable=SC2016 # the shell of fzf expands $PUBLIC_FILE
  PICKED_ROW=$(
    {
      printf '\t\t%s\n' "+ no parent"
      printf '%s\n' "$ZETTELS" | list_rows
    } | fzf --layout reverse --info hidden \
      --delimiter "$TAB" --with-nth 3 \
      --header "place: $CLAIM" \
      --preview '"$PUBLIC_FILE" show --color {1}' \
      --preview-window "right,50%,wrap" \
      --preview-label " [enter] place behind, [esc] keep as draft " \
      --preview-label-pos "0:bottom" \
      --bind "load:pos(${CURSOR_ROW:-1})" \
      --bind "change:first"
  ) || PICK_STATUS=$?

  # fzf: 1 is no match, 130 is Esc or Ctrl+C
  case "$PICK_STATUS" in
    0) ;;
    1 | 130)
      _info -v path "$DRAFT_FILE" "No parent picked, the draft stays"
      exit 4
      ;;
    *) _fail 3 -v status "$PICK_STATUS" "fzf failed" ;;
  esac

  PARENT_ID="${PICKED_ROW%%"$TAB"*}"
  if [ -n "$PARENT_ID" ] && ! _is folgezettel "$PARENT_ID"; then
    _fail 3 -v row "$PICKED_ROW" "fzf printed a row without an id"
  fi
fi

ID=$(
  { printf '%s\n' "$IDS"; find_draft_ids; } | build_next_child_id "$PARENT_ID"
)

write_front_matter_value id "$ID" "$DRAFT_FILE"
write_front_matter_value placed "$(print_now)" "$DRAFT_FILE"

printf '%s\n' "$ID"
_ok -v id "$ID" -v path "$DRAFT_FILE" "Placed"

exit 0
