#!/bin/sh

# zettel ls [--drafts] [--rows]
#
# Print the id and the file name of every zettel, with a tab between them, in
# Folgezettel order. With --drafts, print the path of every draft instead,
# newest first. With --rows, print the rows the picker and the browser show in
# fzf.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

SHOULD_LIST_DRAFTS="" # --drafts, "true" or ""
SHOULD_PRINT_ROWS=""  # --rows, "true" or ""

# ╭───
# │ Main
# ╰───

while [ "$#" -gt 0 ]; do
  case "$1" in
    --drafts)
      SHOULD_LIST_DRAFTS="true"
      shift
      ;;
    --rows)
      SHOULD_PRINT_ROWS="true"
      shift
      ;;
    -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
    *) _fail 2 '"ls" takes no arguments' ;;
  esac
done

if [ -n "$SHOULD_LIST_DRAFTS" ] && [ -n "$SHOULD_PRINT_ROWS" ]; then
  list_draft_files | list_draft_rows
elif [ -n "$SHOULD_LIST_DRAFTS" ]; then
  list_draft_files
elif [ -n "$SHOULD_PRINT_ROWS" ]; then
  list_zettels | list_rows
else
  list_zettels
fi

exit 0
