#!/bin/sh

# zettel show [--color] <id|file>
#
# Print the lineage of a zettel as a tree, an empty line, then its text. For a
# draft, print its text only. With --color, print the text through bat when
# bat is there, in color. The picker and the browser call it for the preview.
# Print nothing for an empty argument: the picker has one row without an id.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

SHOULD_COLOR="" # --color, "true" or ""

# ╭───
# │ Main
# ╰───

case "${1:-}" in
  --color)
    SHOULD_COLOR="true"
    shift
    ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

[ "$#" -eq 1 ] || _fail 2 '"show" needs one id or file'

if [ -z "$1" ]; then
  exit 0
fi

SHOWN_FILE=$(get_note_file "$1")
SHOWN_ID="${SHOWN_FILE##*/}"
SHOWN_ID="${SHOWN_ID%%.*}"

# A draft has no lineage
case "$SHOWN_FILE" in
  "$BOX_DIR"/*)
    # An id is digits and letters, safe to split
    for ID in $(build_lineage "$SHOWN_ID"); do
      build_tree_row "$ID"
    done | build_tree

    printf '\n'
    ;;
esac

# bat sees no terminal in a preview, so show tells it to color and not to page
if [ -n "$SHOULD_COLOR" ] && [ -z "${NO_COLOR:-}" ] \
  && command -v bat >/dev/null 2>&1; then
  bat --color always --style plain --paging never --language markdown \
    -- "$SHOWN_FILE"
else
  cat -- "$SHOWN_FILE"
fi

exit 0
