#!/bin/sh

# zettel browse
#
# Open the browser: every zettel in fzf, in Folgezettel order, with "show
# <id>" as the preview. Type to search the names. Enter opens the zettel under
# the cursor with "edit". When Neovim closes, the browser reads the box again.
# Esc closes the browser. It needs fzf, Neovim and a terminal on stdin: the
# caller opens one.
# zettel runs this file, never call it directly.

set -eu

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/zettels.sh"

# ╭───
# │ Cleanup
# ╰───

# shellcheck disable=SC2329 # called by trap
cleanup() {
  _restore_title
}

trap cleanup EXIT                                    # normal exit
trap 'cleanup; trap - EXIT INT; kill -INT $$' INT    # Ctrl+C
trap 'cleanup; trap - EXIT TERM; kill -TERM $$' TERM # kill, timeout
trap 'cleanup; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

[ "$#" -eq 0 ] || _fail 2 '"browse" takes no arguments'

_require_cmd fzf nvim
[ -t 0 ] || _fail 3 '"browse" needs a terminal'

ZETTELS=$(list_zettels)
if [ -z "$ZETTELS" ]; then
  _info -v box "$BOX_DIR" "The box holds no zettel"
  exit 0
fi

# A waybar click finds an open browser by this title
_set_title "zettel :: browser"

# A row is what list_rows prints. fzf shows and searches the name.
#   {1}               the id under the cursor
#   execute           runs "edit" in this terminal, then shows the list again
#   reload            reads the box again: the user may have changed or
#                     removed the zettel in Neovim
#   --preview-label   the keys, on the bottom border of the preview
STATUS=0
# shellcheck disable=SC2016 # the shell of fzf expands $PUBLIC_FILE
printf '%s\n' "$ZETTELS" \
  | list_rows \
  | fzf --layout reverse --info hidden \
    --delimiter "$TAB" --with-nth 3 \
    --preview '"$PUBLIC_FILE" show --color {1}' \
    --preview-window "right,50%,wrap" \
    --preview-label " [enter] open, [esc] close " \
    --preview-label-pos "0:bottom" \
    --bind 'enter:execute("$PUBLIC_FILE" edit {1})+reload("$PUBLIC_FILE" ls --rows)' \
  || STATUS=$?

# fzf: 1 is no match, 130 is Esc or Ctrl+C. Closing the browser is no error
case "$STATUS" in
  0 | 1 | 130) exit 0 ;;
  *) _fail 3 -v status "$STATUS" "fzf failed" ;;
esac
