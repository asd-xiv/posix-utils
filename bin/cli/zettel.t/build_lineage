#!/bin/sh

# shellcheck disable=SC2329 # the harness calls actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"

# lib.sh reads SCRIPT_DIR as the folder of the command files
SCRIPT_DIR="$SCRIPT_DIR/../zettel.d"
. "$SCRIPT_DIR/../../lib/log.sh"
. "$SCRIPT_DIR/../../lib/validation.sh"
# shellcheck source=../zettel.d/lib.sh
. "$SCRIPT_DIR/lib.sh"

_describe "zettel :: build_lineage"

_test 'given [1b3] should [print 1, 1b and 1b3]'
actual() { build_lineage 1b3; }
_expect equal actual.stdout '1
1b
1b3'

_test 'given [1aa2] a run of two letters, should [keep the run in one id]'
actual() { build_lineage 1aa2; }
_expect equal actual.stdout '1
1aa
1aa2'

_test 'given [12] a top-level id, should [print only 12]'
actual() { build_lineage 12; }
_expect equal actual.stdout '12'
