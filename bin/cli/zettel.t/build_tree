#!/bin/sh

# shellcheck disable=SC2329 # the harness calls prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"

# zettels.sh finds lib.sh from the folder of the command files
SCRIPT_DIR="$SCRIPT_DIR/../zettel.d"
# shellcheck source=../zettel.d/zettels.sh
. "$SCRIPT_DIR/zettels.sh"

_describe "zettel :: build_tree"

_test 'given [a lineage of three with a mark on the last] should [indent each step, keep the mark behind a tab]'
prepare() {
  printf '%s\t%s\n' 1 1.lorem.md 1b 1b.ipsum.md
  printf '%s\t%s\t%s\n' 1b3 1b3.dolor.md newest
}
actual() { build_tree; }
_expect equal actual.stdout '1.lorem.md
 └ 1b.ipsum.md
     └ 1b3.dolor.md	newest'

_test 'given [two top-level zettels] should [print both without an indent]'
prepare() { printf '%s\t%s\n' 1 1.lorem.md 2 2.ipsum.md; }
actual() { build_tree; }
_expect equal actual.stdout '1.lorem.md
2.ipsum.md'

_test 'given [a zettel three steps down] should [indent it by 9 spaces]'
prepare() { printf '%s\t%s\n' 12ab3c 12ab3c.deep.md; }
actual() { build_tree; }
_expect equal actual.stdout '         └ 12ab3c.deep.md'

_test 'given [a label that is a bare id] should [print the id as the label]'
prepare() { printf '%s\t%s\n' 1 1 1a 1a.child.md; }
actual() { build_tree; }
_expect equal actual.stdout '1
 └ 1a.child.md'

_test 'given [no rows] should [print nothing]'
prepare() { :; }
actual() { build_tree; }
_expect equal actual.stdout ''
