#!/bin/sh

set -eu

# NAME
#   recheck - A terminal UI for cron: run checks, keep the last state of each
#
# SYNOPSIS
#   recheck ls [--cron | --color | --columns <names>]
#   recheck enable <id>...
#   recheck disable <id>...
#   recheck toggle <id>...
#   recheck sync [--wait]
#   recheck run [id...]
#   recheck status
#   recheck log
#   recheck show [--color] <id>
#   recheck browse
#   recheck health
#   recheck edit [id]
#   recheck -h | --help
#
# DESCRIPTION
#   A check is a script in ~/.config/recheck/checks. Its file name is its id,
#   a slug: letters, digits, "_" and "-", starting with a letter or a digit.
#   A "_" in front of the file name disables the check and is not part of the
#   id. The exit code of a check is the answer:
#
#     0       green
#     1       red
#     other   broken, the check could not answer. recheck keeps the last
#             green or red, to compare with the next run
#
#   ls prints the last non-empty line of the output of each check. End a check
#   with the line ls should print. ls prints a tab in it as a space.
#
#   A check holds its cron pattern, five fields, in a comment line:
#
#     # CRON: 0 * * * *
#
#   The crontab holds one line per enabled check with a valid cron pattern,
#   inside a block that sync keeps equal to the check files.
#
#     ls        Print every check: state, on or off, id, cron pattern, and
#               the last non-empty line of its output. With --columns, print
#               only the named columns
#     enable    Remove the "_" from the file name, then sync
#     disable   Put a "_" in front of the file name, then sync
#     toggle    Disable each check that is enabled, enable each that is not
#     sync      Make every check executable, then rewrite the recheck block of
#               the crontab from the check files. Print the lines that
#               changed. Run it after a change made outside "recheck edit": a
#               new check, a rename by hand or a changed cron pattern
#     run       Run every enabled check, or only the ones named. Skip a
#               disabled check and a check that is already running. Print
#               "<id>", a tab and "<state>" per check. cron calls it. At a
#               terminal, also print what each check printed, to stderr
#     status    Print the count of enabled checks per state, then how many
#               are running now, as "<green> <red> <broken> <running>". A
#               running check also counts under the state of its last run
#     log       Print the last 10 runs, one line each, and the log file path
#               to stderr.
#     show      Print a check as properties between "---" lines, as in
#               front matter, then the output of its last run, or of the
#               run in progress
#     browse    Open the browser: every check in fzf, with "show <id>" as
#               the preview. There, Tab marks a check. Enter runs the
#               marked checks again, Alt+E enables them and Alt+X disables
#               them. With no check marked, the three act on the check
#               under the cursor. Alt+T toggles the check under the cursor.
#               Alt+Enter edits it in a new terminal window, opened with
#               PU_TERMINAL. The browser needs a terminal and fzf 0.73.0 or
#               newer
#     health    Print each reason recheck cannot work fully on this system,
#               one per line: a missing command, an fzf older than 0.73.0,
#               PU_TERMINAL not set or a script path that is not safe. Print
#               nothing when it finds none. open-os-menu runs health before
#               it lets a person pick browse
#     edit      Start Neovim in ~/.config/recheck, in this terminal. With an
#               id, open only the file of that check. Sync when Neovim
#               closes without an error. Wait for Enter when the sync
#               changed the crontab or failed
#
#   When the state of a check changes from green to red or back, recheck runs
#   the on-change hook, ~/.config/recheck/on-change <id> <old-state>
#   <new-state>, if that file is executable.
#
#   When the run of a check starts, when the run command ends, and after a
#   sync that changed the crontab, recheck runs the on-update hook,
#   ~/.config/recheck/on-update, if that file is executable. recheck passes it
#   no arguments. The call means a check, a state or the running checks may
#   have changed.
#
#   cron runs a job without the variables of your login shell. When
#   ~/.config/recheck/env exists, recheck sources it before each check and
#   each hook.
#
#   recheck keeps the last run, the last green or red, and the last output
#   of a check in ~/.local/state/recheck/<id>/. It appends one line
#   per run to ~/.local/state/recheck/runs.log: time, state, exit code,
#   seconds the run took and id.
#
#   While a check runs, recheck keeps a marker: the file <id>.running in
#   /run/user/<user id>/recheck. While a check has a marker, run skips it, and
#   status, show and "ls --color" report it as running. A run command that ends
#   by "kill -9" leaves the marker. It stays until you remove it, or until the
#   next boot clears /run/user/<user id>.
#
# ARGUMENTS
#   id   Check to act on. Repeatable for enable, disable and run
#
# OPTIONS
#   --cron       With ls, print the crontab line of each enabled check with a
#                valid cron pattern instead
#   --color      With ls, print for a person: a dot in the color of the state,
#                on or off, id. Green, red, yellow for broken, gray before
#                the first run, blue while the check runs.
#                With show, print the property names in bold
#   --columns <names>
#                With ls, print only the named columns, in the order of
#                <names>. <names> holds column names with a comma between
#                them. The names are state, switch (on or off), id, pattern
#                (the cron pattern) and last-line (the last non-empty line of
#                the output). Default: all five, in that order. Not with
#                --cron or --color
#   --wait       With sync, wait for Enter after sync printed the lines that
#                changed, or the warning for a check it left out
#   -h, --help   Print this help
#
# ENVIRONMENT
#   PU_TERMINAL        Command that opens a terminal window and runs the
#                      command written after it. The flag that takes the
#                      command differs per terminal, so include it, eg.
#                      "alacritty --class float --command". Every command of
#                      posix-utils that opens a terminal window reads it. The
#                      browser writes "recheck edit <id>" after it
#   XDG_CONFIG_HOME    Parent of the recheck config (default: ~/.config)
#   XDG_STATE_HOME     Parent of the recheck state (default: ~/.local/state)
#   XDG_RUNTIME_DIR    Parent of the folder "recheck" that holds the markers
#                      (default: /run/user/<user id>). run exits 3 when it
#                      cannot create that folder, or cannot write to it
#   LOG_LEVEL          Last level to print (default: info)
#   NO_COLOR           Disables color when set and non-empty, in log lines
#                      and in the lines sync prints
#
# EXAMPLE
#   recheck enable typescript-eslint-accepts-typescript-7
#   recheck run && recheck ls
#
# EXIT CODES
#   0   Done. For status, no enabled check is red or broken
#   1   For status, at least one enabled check is red or broken. For health,
#       recheck cannot work fully
#   2   Invalid usage
#   3   Could not run, eg. no crontab command or a check without a valid cron
#       pattern. For browse, no fzf, an fzf older than 0.73.0 or no terminal
#
# SEE ALSO
#   crontab, recheck-bar, open-os-menu, nvim, fzf, awk

# tools/install symlinks this script, so "$0" names the link. realpath follows
# it to find lib.sh and recheck.d
SCRIPT_FILE=$(realpath "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_FILE")
. "$SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="recheck"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
  --) shift ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

[ "$#" -eq 0 ] && _fail 2 "No command given"

COMMAND="$1"
shift

# "recheck disable -- foo" works like "recheck disable foo"
if [ "${1:-}" = "--" ]; then
  shift
fi

# ╭───
# │ Main
# ╰───

# One file per command. A slug holds no "/" and no ".", so a command names
# only a file in recheck.d, and never checks.sh
COMMAND_FILE="$SCRIPT_DIR/recheck.d/$COMMAND"

if ! _is slug "$COMMAND" || [ ! -f "$COMMAND_FILE" ] || [ ! -x "$COMMAND_FILE" ]; then
  _fail 2 -v command "$COMMAND" "Unknown command"
fi

exec "$COMMAND_FILE" "$@"
