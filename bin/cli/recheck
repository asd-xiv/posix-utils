#!/bin/sh

set -eu

# NAME
#   recheck - A terminal UI for cron: run checks, keep the last state of each
#
# SYNOPSIS
#   recheck ls [--cron | --color]
#   recheck enable <id>...
#   recheck disable <id>...
#   recheck toggle <id>...
#   recheck sync [--wait]
#   recheck run [id...]
#   recheck status
#   recheck log
#   recheck show [--color] <id>
#   recheck browse
#   recheck edit [id]
#   recheck -h | --help
#
# DESCRIPTION
#   A check is a script in ~/.config/recheck/checks. Its file name is its id,
#   a slug: letters, digits, "_" and "-", starting with a letter or a digit.
#   A "_" in front of the file name disables the check and is not part of the
#   id. The exit code of a check is the answer:
#
#     0       green
#     1       red
#     other   broken, the check could not answer. recheck keeps the last
#             green or red, to compare with the next run
#
#   A check holds its cron pattern, five fields, in a comment line:
#
#     # CRON: 0 * * * *
#
#   The crontab holds one line per enabled check with a valid cron pattern,
#   inside a block that sync keeps equal to the check files.
#
#     ls        Print every check: state, on or off, id, cron pattern
#     enable    Remove the "_" from the file name, then sync
#     disable   Put a "_" in front of the file name, then sync
#     toggle    Disable each check that is enabled, enable each that is not
#     sync      Make every check executable, then rewrite the crontab block
#               from the check files. Print the lines that changed. Run it
#               after a change made outside "recheck edit": a new check, a
#               rename by hand or a changed cron pattern. With --wait, wait
#               for Enter after it printed the lines that changed or a
#               warning
#     run       Run every enabled check, or only the ones named. Skip a
#               disabled check and a check that is already running. Print
#               "<id>", a tab and "<state>" per check. cron calls it. At a
#               terminal, also print what each check printed, to stderr
#     status    Print the count of enabled checks per state, then how many
#               are running now, as "<green> <red> <broken> <running>". A
#               running check also counts under its last state
#     log       Print the last 10 runs, and the log file path to stderr
#     show      Print a check as properties between "---" lines, as in
#               front matter, then the output of its last run, or of the
#               run in progress
#     browse    Open the browser: every check in fzf, with "show <id>" as
#               the preview. There, Enter runs the check again and Tab
#               toggles it. Alt+Enter edits it in a new window and needs
#               RECHECK_TERMINAL
#     edit      Start Neovim in ~/.config/recheck, in this terminal. With an
#               id, open only the file of that check. Sync when Neovim
#               closes without an error. Wait for Enter when the sync
#               changed the crontab or failed
#
#   When the state of a check changes from green to red or back, recheck runs
#   the on-change hook, ~/.config/recheck/on-change <id> <old-state>
#   <new-state>, if that file is executable.
#
#   When a run starts, after run, and after a sync that changed the crontab,
#   recheck runs the on-update hook, ~/.config/recheck/on-update, if that
#   file is executable. recheck passes it no arguments. The call means a
#   check, a state or the running checks may have changed.
#
#   cron runs a job without the variables of your login shell. When
#   ~/.config/recheck/env exists, recheck sources it before each check and
#   each hook.
#
#   recheck keeps the last run, the last green or red, and the last output
#   of a check in ~/.local/state/recheck/<id>/. It appends one line
#   per run to ~/.local/state/recheck/runs.log: time, state, exit code,
#   seconds the run took and id.
#
# ARGUMENTS
#   id   Check to act on. Repeatable for enable, disable and run
#
# OPTIONS
#   --cron       With ls, print the crontab line of each enabled check instead
#   --color      With ls, print for a person: a dot in the color of the state,
#                on or off, id. Green, red, yellow for broken, gray before
#                the first run, blue while the check runs.
#                With show, print the property names in bold
#   --wait       With sync, wait for Enter after it printed the lines that
#                changed or a warning
#   -h, --help   Print this help
#
# ENVIRONMENT
#   RECHECK_TERMINAL   Command that opens a terminal window and runs the
#                      command written after it. The browser writes "recheck
#                      edit <id>" after it. The flag that takes the command
#                      differs per terminal, so include it, eg. "alacritty
#                      --class float --command"
#   XDG_CONFIG_HOME    Parent of the recheck config (default: ~/.config)
#   XDG_STATE_HOME     Parent of the recheck state (default: ~/.local/state)
#   LOG_LEVEL          Last level to print (default: info)
#   NO_COLOR           Disables color when set and non-empty, in log lines
#                      and in the lines sync prints
#
# EXAMPLE
#   recheck enable typescript-eslint-accepts-typescript-7
#   recheck run && recheck ls
#
# EXIT CODES
#   0   Done. For status, no enabled check is red or broken
#   1   For status, at least one enabled check is red or broken
#   2   Invalid usage
#   3   Could not run, eg. no crontab command or a check without a cron pattern
#
# SEE ALSO
#   crontab, recheck-bar, nvim, fzf, awk

# tools/install symlinks this script, so "$0" names the link. realpath follows
# it to find lib.sh
SCRIPT_FILE=$(realpath "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_FILE")
. "$SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="recheck"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
  --) shift ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

[ "$#" -eq 0 ] && _fail 2 "No command given"

COMMAND="$1"
shift

# "recheck disable -- foo" works like "recheck disable foo"
if [ "${1:-}" = "--" ]; then
  shift
fi

# ╭───
# │ Main
# ╰───

# One file per command. A slug holds no "/" and no ".", so a command names
# only a file in recheck.d, and never checks.sh
COMMAND_FILE="$SCRIPT_DIR/recheck.d/$COMMAND"

if ! _is slug "$COMMAND" || [ ! -f "$COMMAND_FILE" ] || [ ! -x "$COMMAND_FILE" ]; then
  _fail 2 -v command "$COMMAND" "Unknown command"
fi

exec "$COMMAND_FILE" "$@"
