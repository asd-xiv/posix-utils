#!/bin/sh

set -eu

# NAME
#   recheck - A terminal UI for cron: run checks, keep the last state of each
#
# SYNOPSIS
#   recheck <command> [ARGS]
#   recheck <command> --help
#   recheck -h | --help
#
# DESCRIPTION
#   A check is a script in ~/.config/recheck/checks. Its file name is its id,
#   a slug: letters, digits, "_" and "-", starting with a letter or a digit.
#   A "_" in front of the file name disables the check and is not part of the
#   id. The exit code of a check is the answer:
#
#     0       green
#     1       red
#     other   broken, the check could not answer. recheck keeps the last
#             green or red, to compare with the next run
#
#   ls prints the last non-empty line of the output of each check. End a check
#   with the line ls should print.
#
#   A check holds its cron pattern, five fields, in a comment line:
#
#     # CRON: 0 * * * *
#
#   Under it, a check can hold a retry line: the most times run runs it again
#   after a run that is not green, then the minutes between two runs
#   (default: 1):
#
#     # RETRY: 3 5
#
#   run stops at the first green. A retry line that is not one or two integers
#   means no retry. The check keeps its lock through its retries and the waits
#   between them. A cron tick in that time skips the check as "Already
#   running", so keep the retries shorter than the cron interval.
#
#   The crontab holds one line per enabled check with a valid cron pattern,
#   inside a block that sync keeps equal to the check files.
#
#     ls        Print every check, one line each
#     enable    Enable checks, then sync
#     disable   Disable checks, then sync
#     toggle    Disable each enabled check, enable each disabled one
#     sync      Write the recheck block of the crontab from the checks
#     run       Run the enabled checks, or the ones named
#     status    Print the count of enabled checks per state
#     log       Print the last runs
#     show      Print a check and the output of its last run
#     browse    Browse the checks in fzf
#     health    Print each reason recheck cannot work fully
#     edit      Edit the checks in Neovim, then sync
#
#   Each command prints its own help with --help.
#
#   When the state of a check changes from green to red or back, recheck runs
#   the on-change hook, ~/.config/recheck/on-change <id> <old-state>
#   <new-state>, if that file is executable.
#
#   When the run of a check starts, when the run command ends, and after a
#   sync that changed the crontab, recheck runs the on-update hook,
#   ~/.config/recheck/on-update, if that file is executable. recheck passes it
#   no arguments. The call means a check, a state or the running checks may
#   have changed.
#
#   cron runs a job without the variables of your login shell. When
#   ~/.config/recheck/env exists, recheck sources it before each check and
#   each hook.
#
# OPTIONS
#   -h, --help   Print this help
#
# ENVIRONMENT
#   XDG_CONFIG_HOME    Parent of the recheck config (default: ~/.config)
#   XDG_STATE_HOME     Parent of the recheck state (default: ~/.local/state)
#   XDG_RUNTIME_DIR    Parent of the folder "recheck" that holds the locks
#                      (default: /run/user/<user id>)
#   LOG_LEVEL          Last level to print (default: info)
#   NO_COLOR           Disables color in log lines when set and non-empty
#
# EXAMPLE
#   recheck enable typescript-eslint-accepts-typescript-7
#   recheck run && recheck ls
#   recheck run --help
#
# EXIT CODES
#   2   No command, or an unknown one
#
#   Every other code comes from the command.
#
# SEE ALSO
#   crontab, recheck-bar, open-os-menu

# tools/install symlinks this script, so "$0" names the link. realpath follows
# it to find lib.sh and recheck.d
SCRIPT_FILE=$(realpath "$0")
SCRIPT_DIR=$(dirname "$SCRIPT_FILE")
. "$SCRIPT_DIR/../lib/log.sh"
. "$SCRIPT_DIR/../lib/validation.sh"
. "$SCRIPT_DIR/../lib/help.sh"

# _log reads these
export LOG_NAMESPACE="recheck"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
  --) shift ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

[ "$#" -eq 0 ] && _fail 2 "No command given"

COMMAND="$1"
shift

# "recheck disable -- foo" works like "recheck disable foo"
if [ "${1:-}" = "--" ]; then
  shift
fi

# ╭───
# │ Main
# ╰───

# One file per command. A slug holds no "/" and no ".", so a command names
# only a file in recheck.d, and never lib.sh
COMMAND_FILE="$SCRIPT_DIR/recheck.d/$COMMAND"

if ! _is slug "$COMMAND" || [ ! -f "$COMMAND_FILE" ] || [ ! -x "$COMMAND_FILE" ]; then
  _fail 2 -v command "$COMMAND" "Unknown command"
fi

exec "$COMMAND_FILE" "$@"
