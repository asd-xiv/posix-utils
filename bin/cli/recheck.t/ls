#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"
. "$SCRIPT_DIR/../../lib/wait.sh"
. "$SCRIPT_DIR/sandbox.sh"

_describe "recheck.d/ls :: ls :: valid"

before_each() { create_sandbox; }

_test 'given [an output of several lines] should [print the last one in column 5]'
prepare() {
  create_check a 0 'printf "first\nsecond\n9.39.2\n"'
}
actual() {
  "$RECHECK" run a >/dev/null
  "$RECHECK" ls | cut -f 5
}
_expect equal actual.stdout '9.39.2'

_test 'given [--columns last-line,id] should [print those two columns in that order]'
prepare() {
  create_check a 0 'printf "x\n"'
}
actual() {
  "$RECHECK" run a >/dev/null
  "$RECHECK" ls --columns last-line,id
}
_expect equal actual.stdout 'x	a'

_test 'given [--color and a check in its first retry] should [print the retry after the id]'
prepare() {
  create_waiting_check a 1 '3 0'
}
actual() {
  start_background_run a
  wait_until_started a 2
  "$RECHECK" ls --color
  finish_background_run
}
_expect end-with actual.stdout 'a [1/3]'

_describe "recheck.d/ls :: ls :: edge"

before_each() { create_sandbox; }

_test 'given [an output that ends with empty lines and a line of spaces] should [print the last line above them]'
prepare() {
  create_check a 0 'printf "first\nlast\n\n  \n\n"'
}
actual() {
  "$RECHECK" run a >/dev/null
  "$RECHECK" ls | cut -f 5
}
_expect equal actual.stdout 'last'

_test 'given [a check that never ran] should [print "-" in column 5]'
prepare() {
  create_check a 0
}
actual() {
  "$RECHECK" ls | cut -f 5
}
_expect equal actual.stdout '-'

_test 'given [a last line with a tab] should [print the tab as a space, keep five columns]'
prepare() {
  create_check a 0 'printf "x\ty\n"'
}
actual() {
  "$RECHECK" run a >/dev/null
  "$RECHECK" ls | awk -F '\t' '{ print NF ":" $5 }'
}
_expect equal actual.stdout '5:x y'

_describe "recheck.d/ls :: ls :: invalid"

before_each() { create_sandbox; }

_test 'given [--columns with a name that is not a column] should [exit 2]'
prepare() {
  create_check a 0
}
actual() {
  "$RECHECK" ls --columns state,color
}
_expect equal actual.exit 2

_test 'given [--columns with no names] should [exit 2]'
prepare() {
  create_check a 0
}
actual() {
  "$RECHECK" ls --columns
}
_expect equal actual.exit 2

_test 'given [--columns with --cron] should [exit 2]'
prepare() {
  create_check a 0
}
actual() {
  "$RECHECK" ls --cron --columns id
}
_expect equal actual.exit 2
