#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"
. "$SCRIPT_DIR/sandbox.sh"

_describe "recheck :: browse"

before_each() { build_sandbox; }

# Tab marks a row and moves down: two Tabs mark both rows. Alt+X disables them
_test 'given [two enabled checks] should [disable both on Tab, Tab, Alt+X, Esc]'
prepare() {
  add_check a 0
  add_check b 1
  "$RECHECK" sync >/dev/null
}
actual() {
  _send_keys "$RECHECK browse" 1 tab 0.3 tab 0.3 alt-x 1.5 esc
  "$RECHECK" ls
}
_expect eq actual.exit 0
_expect eq actual.stdout "$(printf '%s\toff\t%s\t* * * * *\n' - a - b)"
