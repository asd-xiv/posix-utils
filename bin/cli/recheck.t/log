#!/bin/sh

# shellcheck disable=SC2329 # the harness calls before_each, prepare and actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../../tools/test-lib.sh"
. "$SCRIPT_DIR/sandbox.sh"
. "$SCRIPT_DIR/../../lib/wait.sh" # for wait_until_started

# run_check <id> [count]
# Run the check <id> <count> times through "recheck run" (default: 1). Each
# run appends its line to the run log.
run_check() {
  rc_count=${2:-1}
  while [ "$rc_count" -gt 0 ]; do
    "$RECHECK" run "$1" >/dev/null
    rc_count=$((rc_count - 1))
  done
}

# create_numbered_check <id>
# Write an enabled check that exits with the number of its run: 1 on its first
# run, 2 on its second. A test tells the runs apart by their exit code.
create_numbered_check() {
  cat >"config/recheck/checks/$1" <<CHECK
#!/bin/sh
# CRON: * * * * *
n=\$((\$(cat "$PWD/$1.count" 2>/dev/null || echo 0) + 1))
printf '%s\\n' "\$n" >"$PWD/$1.count"
exit "\$n"
CHECK
  chmod +x "config/recheck/checks/$1"
}

_describe "recheck.d/log :: log :: valid"

before_each() { create_sandbox; }

_test 'given [no flag] should [print the last 10 runs]'
prepare() {
  create_check a 0
  run_check a 12
}
actual() { "$RECHECK" log 2>/dev/null | wc -l | tr -d ' '; }
_expect equal actual.exit 0
_expect equal actual.stdout '10'

_test 'given [-n 2] should [print the last 2 runs]'
prepare() {
  create_numbered_check a
  run_check a 5
}
actual() { "$RECHECK" log -n 2 2>/dev/null | cut -f 3; }
_expect equal actual.stdout '4
5'

_test 'given [an id] should [print only the runs of that check]'
prepare() {
  create_check a 0
  create_check b 0
  run_check a 2
  run_check b
  run_check a
}
actual() { "$RECHECK" log b 2>/dev/null | cut -f 5; }
_expect equal actual.stdout 'b'

_test 'given [-n 2 and two ids] should [print the last 2 runs of those checks]'
prepare() {
  for id in a b c; do
    create_check "$id" 0
    run_check "$id"
  done
  run_check a
}
actual() { "$RECHECK" log -n 2 a b 2>/dev/null | cut -f 5; }
_expect equal actual.stdout 'b
a'

_test 'given [a Folgezettel, 05] should [print the runs of the check at 05 and of each check under it, not of 051]'
prepare() {
  for id in 05_a 05a_b 05a1_c 051_d 06_e; do
    create_check "$id" 0
    run_check "$id"
  done
}
actual() { "$RECHECK" log 05 2>/dev/null | cut -f 5; }
_expect equal actual.exit 0
_expect equal actual.stdout '05_a
05a_b
05a1_c'

_test 'given [a Folgezettel and an id] should [print the runs of both]'
prepare() {
  for id in 05_a 05a_b 06_c 07_d; do
    create_check "$id" 0
    run_check "$id"
  done
}
actual() { "$RECHECK" log 05a 07_d 2>/dev/null | cut -f 5; }
_expect equal actual.stdout '05a_b
07_d'

_describe "recheck.d/log :: log :: edge"

before_each() { create_sandbox; }

_test 'given [no run log] should [print nothing and exit 0]'
actual() { "$RECHECK" log 2>/dev/null; }
_expect equal actual.exit 0
_expect equal actual.stdout ''

_test 'given [a retry line with a sixth field] should [read the id from the fifth field]'
prepare() {
  create_check a 1
  printf '# RETRY: 3 0\n' >>config/recheck/checks/a
  run_check a
}
actual() { "$RECHECK" log a 2>/dev/null | tail -n 1 | cut -f 5,6; }
_expect equal actual.stdout 'a	3/3'

_test 'given [foo, an id with no _] should [print the runs of foo, not of foobar]'
prepare() {
  create_check foo 0
  create_check foobar 0
  run_check foo
  run_check foobar
}
actual() { "$RECHECK" log foo 2>/dev/null | cut -f 5; }
_expect equal actual.stdout 'foo'

_describe "recheck.d/log :: log :: invalid"

before_each() { create_sandbox; }

_test 'given [-n with no count] should [exit 2]'
actual() { "$RECHECK" log -n; }
_expect equal actual.exit 2

_test 'given [-n 0 or -n abc] should [exit 2 for each]'
actual() {
  for count in 0 abc; do
    "$RECHECK" log -n "$count" 2>/dev/null || printf '%s\n' "$?"
  done
}
_expect equal actual.stdout '2
2'

_test 'given [an id with no check] should [exit 2]'
actual() { "$RECHECK" log nope_x; }
_expect equal actual.exit 2
_expect contain actual.stderr 'No such check'

_test 'given [a Folgezettel with no check] should [exit 2]'
prepare() { create_check 05_a 0; }
actual() { "$RECHECK" log 09; }
_expect equal actual.exit 2
_expect contain actual.stderr 'No check at this Folgezettel'
