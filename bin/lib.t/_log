#!/bin/sh

# shellcheck disable=SC2329 # the harness calls actual
SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../../tools/test-lib.sh"
. "$SCRIPT_DIR/../lib.sh"

_describe "lib.sh :: _log"

_test 'given [NO_LOG_TIME unset] should [print the time before the level]'
actual() {
  unset NO_LOG_TIME LOG_NAMESPACE
  _log error "hi" 2>&1 | awk '{ print NF, $2, $3 }'
}
_expect equal actual.stdout '3 ERR hi'

_test 'given [NO_LOG_TIME empty] should [print the time before the level]'
actual() {
  unset LOG_NAMESPACE
  NO_LOG_TIME=""
  _log error "hi" 2>&1 | awk '{ print NF, $2, $3 }'
}
_expect equal actual.stdout '3 ERR hi'

_test 'given [NO_LOG_TIME non-empty] should [print no time]'
actual() {
  unset LOG_NAMESPACE
  NO_LOG_TIME=1
  _log error "hi" 2>&1
}
_expect equal actual.stdout 'ERR hi'

_test 'given [NO_LOG_TIME and a namespace] should [print the namespace after the level]'
actual() {
  NO_LOG_TIME=1
  LOG_NAMESPACE="vblocks"
  _log error -v key "value" "hi" 2>&1
}
_expect equal actual.stdout 'ERR vblocks: hi key=value'

_test 'given [-- before a message that starts with -v] should [print the message as written]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  _log error -v key "value" -- "-v is a flag" 2>&1
}
_expect equal actual.stdout 'ERR -v is a flag key=value'

_test 'given [-- before a message that starts with --] should [drop the -- and print the message]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  _log error -- "--max needs a count" 2>&1
}
_expect equal actual.stdout 'ERR --max needs a count'

_test 'given [LOG_LEVEL=success] should [exit 2 and name the unknown value]'
actual() {
  LOG_LEVEL=success
  _log error "hi"
}
_expect equal actual.exit '2'
_expect contain actual.stderr 'Unknown log level "success"'

_test 'given [LOG_LEVEL=WARN] should [print a warning line and hide an info line]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  LOG_LEVEL=WARN
  _log warning "shown" 2>&1
  _log info "hidden" 2>&1
}
_expect equal actual.stdout 'WRN shown'

_test 'given [LOG_LEVEL=warning] should [print a success line]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  LOG_LEVEL=warning
  _ok "done" 2>&1
}
_expect equal actual.stdout 'SUC done'

_test 'given [LOG_LEVEL=error] should [print a success line and hide a warning line]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  LOG_LEVEL=error
  _warn "stale" 2>&1
  _ok "done" 2>&1
}
_expect equal actual.stdout 'SUC done'

_test 'given [LOG_LEVEL unset] should [print a success line]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  unset LOG_LEVEL
  _ok "done" 2>&1
}
_expect equal actual.stdout 'SUC done'

_test 'given [type INFO] should [print an info line]'
actual() {
  NO_LOG_TIME=1
  unset LOG_NAMESPACE
  LOG_LEVEL=info
  _log INFO "hi" 2>&1
}
_expect equal actual.stdout 'INF hi'

_test 'given [_log trace] should [exit 2 and name the unknown type]'
actual() {
  _log trace "hi"
}
_expect equal actual.exit '2'
_expect contain actual.stderr 'Unknown log type "trace"'
