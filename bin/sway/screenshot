#!/bin/sh

set -eu

# NAME
#   screenshot - Capture the screens, a window or a region to a PNG file
#
# SYNOPSIS
#   screenshot <target> [OPTIONS]
#
# DESCRIPTION
#   Captures the target to a PNG file, then prints the file path to stdout.
#   Copies the image to the clipboard when wl-copy is installed. Then beeps
#   and sends a notification, see NO_NOTIFY.
#
#   Hides the cursor while it captures. grim leaves the cursor out, but Sway
#   can draw it into the screen image, eg. with WLR_NO_HARDWARE_CURSORS=1.
#   On exit, sets the Sway hide_cursor timeout to 0, the Sway default. A
#   hide_cursor from the sway config stays off until the next reload.
#
# ARGUMENTS
#   target   What to capture:
#              all      Every screen
#              window   The window the user clicks
#              region   The rectangle the user draws, or --geometry
#
# OPTIONS
#   -o, --output <file>         PNG file to write (default: <target>_<date>.png
#                               in Screenshots of the XDG pictures folder,
#                               or of ~/Pictures)
#   -g, --geometry <x,y wxh>    With region: capture this area, no picker
#   -h, --help                  Print this help
#
# ENVIRONMENT
#   NO_NOTIFY   Skips the beep and the notification when non-empty,
#               eg. for a script that captures many files in a row
#
# EXAMPLE
#   bindsym Print exec screenshot all
#   bindsym $mod+Print exec screenshot window
#   NO_NOTIFY=1 screenshot region --geometry "0,0 800x600" -o top-left.png
#
# EXIT CODES
#   0   Captured
#   2   Invalid usage
#   3   Could not run, eg. no Sway session, grim failed
#   4   The user picked nothing
#
# SEE ALSO
#   grim, slurp, swaymsg, jq, wl-copy, xdg-user-dir, doomst, beep_success,
#   beep_cancel

_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="screenshot"
export LOG_LEVEL="${LOG_LEVEL:-info}"

_OUTPUT_FILE="" # -o/--output, a .png path
_GEOMETRY=""    # -g/--geometry, a geometry

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  all | window | region) _TARGET="$1" ;;
  "")
    _show_help "$0" >&2
    exit 2
    ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
  *) _fail 2 -v target "$1" "Unknown target. Use all, window or region" ;;
esac
shift

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      _show_help "$0"
      exit 0
      ;;
    -o | --output)
      [ "$#" -lt 2 ] && _fail 2 "--output needs a file"
      _OUTPUT_FILE="$2"
      shift 2
      ;;
    -g | --geometry)
      [ "$#" -lt 2 ] && _fail 2 "--geometry needs <x>,<y> <width>x<height>"
      _is geometry "$2" || _fail 2 -v geometry "$2" "Not a geometry"
      _GEOMETRY="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
    *) break ;;
  esac
done

[ "$#" -eq 0 ] || _fail 2 -v argument "$1" "Only one target"

if [ -n "$_GEOMETRY" ] && [ "$_TARGET" != "region" ]; then
  _fail 2 -v target "$_TARGET" "--geometry works only with region"
fi

if [ -z "$_OUTPUT_FILE" ]; then
  _OUTPUT_FILE="$(_get_user_dir PICTURES "$HOME/Pictures")/Screenshots/${_TARGET}_$(date +%Y-%m-%dT%H:%M:%S%z).png"
fi

case "$_OUTPUT_FILE" in
  *.png) ;;
  *) _fail 2 -v file "$_OUTPUT_FILE" "Unsupported extension. Use .png" ;;
esac

_require_cmd swaymsg grim
if [ "$_TARGET" != "all" ] && [ -z "$_GEOMETRY" ]; then
  _require_cmd jq slurp
fi
_require_sway

# ╭───
# │ Cleanup
# ╰───

trap _restore_sway_cursor EXIT                                    # normal exit
trap '_restore_sway_cursor; trap - EXIT INT; kill -INT $$' INT    # Ctrl-C
trap '_restore_sway_cursor; trap - EXIT TERM; kill -TERM $$' TERM # kill
trap '_restore_sway_cursor; trap - EXIT HUP; kill -HUP $$' HUP    # closed window

# ╭───
# │ Main
# ╰───

# With no geometry, grim captures every screen
if [ "$_TARGET" != "all" ] && [ -z "$_GEOMETRY" ]; then
  _GEOMETRY=$(_pick_sway_geometry "$_TARGET") || {
    _warn "Nothing picked"
    _notify_cancel
    exit 4
  }
fi

mkdir -p -- "$(dirname -- "$_OUTPUT_FILE")" \
  || _fail 3 -v file "$_OUTPUT_FILE" "Could not add the folder"

_hide_sway_cursor

if [ -n "$_GEOMETRY" ]; then
  set -- -g "$_GEOMETRY"
fi
grim "$@" -- "$_OUTPUT_FILE" \
  || _fail 3 -v file "$_OUTPUT_FILE" "grim failed"

# wl-copy forks a process that serves the clipboard until the next copy. It
# keeps the fds it got, so a caller that reads stdout, eg. $(screenshot all),
# would wait for that next copy
if command -v wl-copy >/dev/null 2>&1; then
  wl-copy <"$_OUTPUT_FILE" >/dev/null 2>&1 || _warn "Could not copy the image"
fi

printf '%s\n' "$_OUTPUT_FILE"

_notify_success "screenshot $_TARGET" "$_OUTPUT_FILE"

exit 0
