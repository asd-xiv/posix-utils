#!/bin/sh

set -eu

# NAME
#   jot - Write a quick note in Neovim, print it to stdout
#
# SYNOPSIS
#   jot [-c|--continue]
#   ... | jot
#
# DESCRIPTION
#   Opens a note in Neovim, in a new terminal window, then prints it to
#   stdout. Piped input is appended to the note before editing, so jot reads
#   as an editable echo.
#
#   Notes live in JOT_HOME and are kept, so --continue can reopen the last
#   one. Nothing is written to /tmp.
#
# OPTIONS
#   -c, --continue   Reopen the last note
#   -h, --help       Print this help
#
# ENVIRONMENT
#   JOT_HOME      Note directory (default: ~/.jot)
#   PU_TERMINAL   Command that opens a terminal window and runs the command
#                 written after it. The flag that takes the command differs
#                 per terminal, so include it, eg. "alacritty --class float
#                 --command". Every command of posix-utils that opens a
#                 terminal window reads it. jot writes "nvim" and its
#                 arguments after it. The PU_TERMINAL command must not return
#                 before its window closes
#
# EXAMPLE
#   jot > ~/notes/$(date +%Y-%m-%d).md
#   cat fn.js | jot | claude -p "explain this"
#
# EXIT CODES
#   0       Note printed
#   1       Nothing written
#   2       Invalid usage, or PU_TERMINAL not set
#   3       Could not run
#   other   The exit code of the PU_TERMINAL command, when it fails
#
# SEE ALSO
#   nvim

SCRIPT_DIR=$(dirname "$(realpath "$0")")
LOG_NAMESPACE="jot"
. "$SCRIPT_DIR/../lib.sh"

JOT_HOME="${JOT_HOME:-${HOME}/.jot}"
LAST_NOTE_LINK="${JOT_HOME}/last-note"
SHOULD_CONTINUE=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      _show_help "$0"
      exit 0
      ;;
    -c | --continue)
      SHOULD_CONTINUE="true"
      shift
      ;;
    --)
      shift
      break
      ;;
    -?*)
      _fail 2 -v flag "$1" "Unknown flag."
      ;;
    *) break ;;
  esac
done

[ "$#" -eq 0 ] \
  || _fail 2 -v argument "$1" "jot takes no arguments. Pipe text instead."

_require_var PU_TERMINAL
_require_cmd nvim

mkdir -p "${JOT_HOME}/notes"

# ╭───
# │ Main
# ╰───

NOTE_FILE=""
[ -n "$SHOULD_CONTINUE" ] && [ -f "$LAST_NOTE_LINK" ] && {
  NOTE_FILE=$(cat "$LAST_NOTE_LINK")
  [ -f "$NOTE_FILE" ] || {
    _warn -v path "$NOTE_FILE" "The last note is gone. Starting a new one."
    NOTE_FILE=""
  }
}

[ -z "$NOTE_FILE" ] && {
  NOTE_FILE=$(mktemp "${JOT_HOME}/notes/$(date +%Y-%m-%d).XXXXXX") \
    || _fail 3 "Could not create a note."
}

# Record the note before editing, so --continue works even when the editor
# is closed without saving.
printf '%s' "$NOTE_FILE" >"$LAST_NOTE_LINK"

# Piped input becomes the starting text.
[ -t 0 ] || cat >>"$NOTE_FILE"

# The command is split into words on purpose: the user writes it with its
# flags. It must not return before its window closes, or jot prints the note
# too early. Neovim names the window through 'titlestring', and only with its
# 'title' option on, which is off by default
# shellcheck disable=SC2086 # split into words on purpose
$PU_TERMINAL nvim \
  -c "set title" \
  -c "let &titlestring = 'jot - $(basename "$NOTE_FILE")'" \
  -c "setlocal syntax=markdown" \
  -c "setlocal wrap" \
  -c "setlocal spell" \
  "$NOTE_FILE"

[ -s "$NOTE_FILE" ] || {
  _info "Nothing written."
  exit 1
}

cat "$NOTE_FILE"
