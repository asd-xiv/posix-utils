#!/bin/sh

set -eu

# NAME
#   recheck-bar - Print the count of checks per state, as JSON for waybar
#
# SYNOPSIS
#   recheck-bar [-h]
#
# DESCRIPTION
#   Counts the enabled checks per state and prints one JSON line for a waybar
#   module with "return-type": "json".
#
#     text      Green and red counts, eg. "✓ 2 ✗ 1". Adds "? 1" for broken
#               checks and "⟳ 1" while a check runs. Empty when recheck has
#               no check, enabled or disabled, so waybar hides the module
#     tooltip   What "recheck ls" prints, with " | " between the columns. The
#               last line of the output of each check is part of it. recheck-bar
#               escapes the tooltip for JSON and for markup
#     class     red when a check is red, else broken when a check is broken,
#               else green. Empty when recheck has no check
#
# OPTIONS
#   -h, --help   Print this help
#
# EXAMPLE
#   In the waybar config:
#
#     "custom/recheck": {
#       "exec": "recheck-bar",
#       "return-type": "json",
#       "interval": 60,
#       "signal": 8,
#       "on-click": "alacritty --command recheck browse &",
#       "on-click-right": "alacritty --command recheck edit &"
#     }
#
#   End each click command with "&". waybar does not refresh a module while
#   one of its click commands runs, and "recheck browse" runs until its fzf
#   window closes.
#
#   In ~/.config/recheck/on-update, to refresh the module after every change:
#
#     pkill -RTMIN+8 waybar
#
# EXIT CODES
#   0   Line printed
#   2   Invalid usage
#   3   Could not run, eg. recheck failed
#
# SEE ALSO
#   recheck, jq, waybar-custom(5)

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="recheck-bar"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "" | --) ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
  *) _fail 2 -v argument "$1" "recheck-bar takes only --help" ;;
esac

_require_cmd jq

# ╭───
# │ Main
# ╰───

RECHECK_FILE="$SCRIPT_DIR/../cli/recheck"
[ -x "$RECHECK_FILE" ] \
  || _fail 3 -v path "$RECHECK_FILE" "recheck not found, install the cli group"

# status exits 1 when a check is red or broken, which is an answer here
STATUS=0
COUNTS=$("$RECHECK_FILE" status) || STATUS=$?
[ "$STATUS" -le 1 ] || _fail 3 "recheck status failed"

# shellcheck disable=SC2086 # split the four counts on purpose
set -- $COUNTS
[ "$#" -eq 4 ] || _fail 3 -v got "$COUNTS" "recheck status did not print four counts"
GREEN_COUNT="$1" RED_COUNT="$2" BROKEN_COUNT="$3" RUNNING_COUNT="$4"

TOOLTIP=$("$RECHECK_FILE" ls --delimiter ' | ') || _fail 3 "recheck ls failed"

TEXT=""
CLASS=""
if [ -n "$TOOLTIP" ]; then
  TEXT="✓ $GREEN_COUNT ✗ $RED_COUNT"
  CLASS="green"

  if [ "$BROKEN_COUNT" -gt 0 ]; then
    TEXT="$TEXT ? $BROKEN_COUNT"
    CLASS="broken"
  fi

  if [ "$RED_COUNT" -gt 0 ]; then
    CLASS="red"
  fi

  if [ "$RUNNING_COUNT" -gt 0 ]; then
    TEXT="$TEXT ⟳ $RUNNING_COUNT"
  fi
fi

# The last line of the output of a check is free text. jq escapes it for the
# JSON, and @html escapes it for the markup of the tooltip
jq --null-input --compact-output \
  --arg text "$TEXT" --arg tooltip "$TOOLTIP" --arg class "$CLASS" \
  '{text: $text, tooltip: ($tooltip | @html), class: $class}'

exit 0
