#!/bin/sh

set -eu

# NAME
#   screenrecord - Record a window or a region to a video or GIF file
#
# SYNOPSIS
#   screenrecord <command> [ARGS]
#   screenrecord -h
#
# DESCRIPTION
#   Records a window or a region of the screen to a video or GIF file. One
#   recording runs at a time.
#
#     start   Record in the background
#     stop    End the recording, print the file
#
#   Each command prints its own help with --help.
#
# OPTIONS
#   -h, --help   Print this help
#
# EXIT CODES
#   2   No command, or an unknown one
#
#   Every other code comes from the command.
#
# SEE ALSO
#   screenshot, capture-terminal, wf-recorder

# tools/install symlinks this script, so "$0" names the link. realpath follows
# it to find lib.sh and screenrecord.d
_SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$_SCRIPT_DIR/../lib.sh"

# _log reads these
export LOG_NAMESPACE="screenrecord"
export LOG_LEVEL="${LOG_LEVEL:-info}"

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0" >&2
    exit 2
    ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

_COMMAND="$1"
shift

# ╭───
# │ Main
# ╰───

# One file per command. A slug holds no "/" and no ".", so a command names
# only a file in screenrecord.d, and never lock.sh
_COMMAND_FILE="$_SCRIPT_DIR/screenrecord.d/$_COMMAND"

if ! _is slug "$_COMMAND" || [ ! -f "$_COMMAND_FILE" ] \
  || [ ! -x "$_COMMAND_FILE" ]; then
  _fail 2 -v command "$_COMMAND" "Unknown command. Use start or stop"
fi

exec "$_COMMAND_FILE" "$@"
