#!/bin/sh

set -eu

# NAME
#   verify - Lint, parse and smoke test shell scripts
#
# SYNOPSIS
#   verify [-h] <path>...
#
# DESCRIPTION
#   Runs shellcheck on each shell script, or on every one under a directory,
#   and parses it under /bin/sh. A command, a file without an extension,
#   must also be executable and pass a smoke test under /bin/sh:
#
#     --help            must exit 0
#     an unknown flag   must exit 2
#
#   A sourced library, a *.sh file, must not be executable.
#
#   A command must source each file of bin/lib whose function it calls, and
#   each file their header lists under Needs. The calls of a file the command
#   sources count as its own, eg. a parts lib.sh.
#
#   A private command, a command under a *.d directory, skips the smoke test.
#   Only its public command runs a private command, so it has no man page.
#
#   A test file, a command under a *.t directory, also skips the smoke test.
#   Any run of a test file runs its tests.
#
#   CI and a developer run the same checks through this one script.
#
# ARGUMENTS
#   path   Shell script, or directory to search for shell scripts, repeatable
#
# OPTIONS
#   -h, --help    Print this help
#
# EXAMPLE
#   verify ./bin ./tools
#   verify ./bin/sway/window-title ./bin/sway/pick-color
#
# EXIT CODES
#   0   Every script passed
#   1   At least one script failed
#   2   Invalid usage
#   3   Could not run
#
# SEE ALSO
#   sh, shellcheck

SCRIPT_DIR=$(dirname "$(realpath "$0")")
. "$SCRIPT_DIR/../bin/lib/log.sh"
. "$SCRIPT_DIR/../bin/lib/validation.sh"
. "$SCRIPT_DIR/../bin/lib/guard.sh"
. "$SCRIPT_DIR/../bin/lib/help.sh"

# _log reads it
export LOG_NAMESPACE="verify"

LIB_DIR=$(realpath "$SCRIPT_DIR/../bin/lib")

# ╭───
# │ Primitives
# ╰───

# skips_smoke_test <file>
#
# Tell if <file> is under a directory whose name ends in .d or .t. Only its
# public command runs a *.d file, so it has no man page and no --help. A *.t
# file is a test file. Running it runs its tests.
#
# RETURNS
#   0   A directory above <file> ends in .d or .t
#   1   None does
skips_smoke_test() {
  case "$1" in
    *.d/* | *.t/*) return 0 ;;
  esac

  return 1
}

# list_sourced_files <file>
#
# Print the path of each file that <file> sources with a line like
# . "$SCRIPT_DIR/<path>" or . "$_SCRIPT_DIR/<path>", read from the folder of
# <file>. Print only the files that exist.
list_sourced_files() {
  lsf_dir=$(dirname "$(realpath "$1")")

  # shellcheck disable=SC2016 # the pattern matches a literal $SCRIPT_DIR
  sed -n 's/^[[:space:]]*\. "\$_\{0,1\}SCRIPT_DIR\/\([^"]*\)".*/\1/p' "$1" \
    | while IFS= read -r lsf_path; do
      [ -f "$lsf_dir/$lsf_path" ] || continue
      realpath "$lsf_dir/$lsf_path"
    done
}

# list_called_functions <file>...
#
# Print each name like _name that the code of <file> calls, once. Skip
# comment lines, and a name inside a longer word, eg. lib_is_x.
list_called_functions() {
  grep -hv '^[[:space:]]*#' "$@" \
    | grep -oE '(^|[^A-Za-z0-9_$])_[a-z][a-z_]*' \
    | sed 's/^[^_]//' \
    | sort -u
}

# find_topic <function>
#
# Print the name of the file of bin/lib that defines <function>, eg. log for
# _fail. Print nothing when none does.
find_topic() {
  grep -l "^$1()" "$LIB_DIR"/*.sh 2>/dev/null | sed 's|.*/||; s|\.sh$||'
}

# list_needs <topic>
#
# Print the topics that the header of bin/lib/<topic>.sh lists under Needs,
# one per line.
list_needs() {
  sed -n 's/^#   Needs \([a-z., ]*\)\. A .*/\1/p' "$LIB_DIR/$1.sh" \
    | tr ',' '\n' | sed 's/^ *//; s/\.sh$//' | grep -v '^$' || true
}

# find_missing_topics <file>
#
# Print each topic of bin/lib that <file> needs and does not source, one per
# line: the topic of each function that <file>, or a file it sources, calls,
# and what each needed topic needs.
find_missing_topics() {
  fmt_sourced=$(list_sourced_files "$1")
  fmt_topics=$(printf '%s\n' "$fmt_sourced" | sed -n "s|^$LIB_DIR/\([a-z]*\)\.sh$|\1|p")
  fmt_others=$(printf '%s\n' "$fmt_sourced" | grep -v "^$LIB_DIR/" || true)

  fmt_needed=$(
    # shellcheck disable=SC2086 # one path per word, none has a space
    for fmt_fn in $(list_called_functions "$1" $fmt_others); do
      find_topic "$fmt_fn"
    done
    for fmt_topic in $fmt_topics; do
      printf '%s\n' "$fmt_topic"
    done
  )

  for fmt_topic in $(printf '%s\n' "$fmt_needed" | sort -u); do
    printf '%s\n' "$fmt_topic"
    list_needs "$fmt_topic"
  done | sort -u | while IFS= read -r fmt_topic; do
    printf '%s\n' "$fmt_topics" | grep -qx "$fmt_topic" \
      || printf '%s\n' "$fmt_topic"
  done
}

# ╭───
# │ Bootstrap
# ╰───

case "${1:-}" in
  -h | --help)
    _show_help "$0"
    exit 0
    ;;
  "")
    _show_help "$0"
    exit 2
    ;;
  --) shift ;;
  -?*) _fail 2 -v flag "$1" "Unknown flag" ;;
esac

_require_cmd shellcheck

[ "$#" -eq 0 ] && _fail 2 "No path given"

for TARGET in "$@"; do
  [ -e "$TARGET" ] || _fail 2 -v path "$TARGET" "No such file or directory"
done

# ╭───
# │ Main
# ╰───

FILES=$(find "$@" -type f)
RC=0

# Read FILES from a heredoc, not a pipe. A pipe runs the loop in a subshell,
# so RC would not outlive it. read splits on newlines only, so a path with
# spaces stays whole.
while IFS= read -r FILE; do
  [ -z "$FILE" ] && continue

  # Skip a file without a sh shebang
  head -1 "$FILE" 2>/dev/null | grep -qEv '^#!.*[/ ](sh|bash|dash|ash)$' \
    && continue

  FILE_RC=0

  shellcheck -x --source-path=SCRIPTDIR -s sh "$FILE" || {
    _error -v script "$FILE" "shellcheck failed"
    FILE_RC=1
  }

  /bin/sh -n "$FILE" || {
    _error -v script "$FILE" "/bin/sh could not parse"
    FILE_RC=1
  }

  case "$FILE" in
    *.sh)
      if [ -x "$FILE" ]; then
        _error -v script "$FILE" "A sourced library must not be executable"
        FILE_RC=1
      fi
      ;;
    *)
      [ -x "$FILE" ] || {
        _error -v script "$FILE" "A command must be executable"
        FILE_RC=1
      }

      MISSING=$(find_missing_topics "$FILE")
      if [ -n "$MISSING" ]; then
        _error -v script "$FILE" -v missing "$(printf '%s' "$MISSING" | tr '\n' ' ')" \
          "A file of bin/lib is not sourced"
        FILE_RC=1
      fi

      if ! skips_smoke_test "$FILE"; then
        /bin/sh "$FILE" --help >/dev/null || {
          _error -v script "$FILE" "--help failed"
          FILE_RC=1
        }

        FLAG_RC=0
        /bin/sh "$FILE" --zz-not-a-real-flag >/dev/null 2>&1 || FLAG_RC=$?

        if [ "$FLAG_RC" -ne 2 ]; then
          _error -v script "$FILE" -v got "$FLAG_RC" \
            "An unknown flag did not exit 2"
          FILE_RC=1
        fi
      fi
      ;;
  esac

  if [ "$FILE_RC" -eq 0 ]; then
    _ok -v script "$FILE" "Passed"
  else
    RC=1
  fi
done <<EOF
$FILES
EOF

exit "$RC"
